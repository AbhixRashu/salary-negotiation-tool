{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "google-search": {
      "type": "remote",
      "url": "https://serp.mcp.acedata.cloud/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:ACEDATACLOUD_API_KEY}"
      }
    }
  },
  "provider": {
    "google": {
      "name": "Google Gemini",
      "api": "https://generativelanguage.googleapis.com/v1beta",
      "env": ["GEMINI_API_KEY"],
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    }
  }
}
