---
import Layout from "../layouts/Layout.astro";
import { ROLES } from "../data/salaries";
const rolesJson = JSON.stringify(ROLES);
---

<Layout
  title="Follow-Up Email Generator — Reply to Recruiter | Salary Pitcher"
  description="Paste the recruiter's latest email and get an AI-written reply that continues your negotiation thread naturally."
>
  <div class="w-full space-y-8 max-w-3xl mx-auto">
    <div class="reveal">
      <h1 class="text-3xl font-semibold tracking-tight text-ink mb-2">Follow-Up Email Generator</h1>
      <p class="text-sm text-body">Already started negotiating? Paste the recruiter's latest email and we'll craft your reply — context-aware, tone-matched, ready to send.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 reveal">
      <!-- Context Card -->
      <div class="border border-hairline bg-canvas p-5 sm:p-6 rounded-lg shadow-sm">
        <h2 class="text-sm font-semibold text-ink mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
          Your Offer Details
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="text-[10px] font-mono text-mute uppercase tracking-wider block mb-1">Role</label>
            <input type="text" id="fuRole" class="w-full px-3 py-2 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none" placeholder="e.g. Software Engineer" />
          </div>
          <div>
            <label class="text-[10px] font-mono text-mute uppercase tracking-wider block mb-1">Company</label>
            <input type="text" id="fuCompany" class="w-full px-3 py-2 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none" placeholder="e.g. Stripe" />
          </div>
          <div>
            <label class="text-[10px] font-mono text-mute uppercase tracking-wider block mb-1">Target Salary</label>
            <input type="number" id="fuTarget" class="w-full px-3 py-2 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none font-mono" placeholder="e.g. 145000" />
          </div>
          <div>
            <label class="text-[10px] font-mono text-mute uppercase tracking-wider block mb-1">Tone</label>
            <select id="fuTone" class="w-full px-3 py-2 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none">
              <option value="confident-polite">Confident & Polite</option>
              <option value="assertive">Assertive</option>
              <option value="warm-collaborative">Warm & Collaborative</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Your Previous Email -->
      <div class="border border-hairline bg-canvas p-5 sm:p-6 rounded-lg shadow-sm">
        <h2 class="text-sm font-semibold text-ink mb-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
          Your Previous Email <span class="text-[10px] font-mono text-mute font-normal">(optional — we'll work with what we have)</span>
        </h2>
        <textarea id="fuPreviousEmail" class="w-full h-28 px-3.5 py-2.5 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none resize-y" placeholder="Paste the email you already sent to them (if any)..."></textarea>
      </div>

      <!-- Recruiter's Latest Email -->
      <div class="border border-hairline bg-canvas p-5 sm:p-6 rounded-lg shadow-sm">
        <h2 class="text-sm font-semibold text-ink mb-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
          Recruiter's Latest Reply
        </h2>
        <textarea id="fuRecruiterEmail" class="w-full h-36 px-3.5 py-2.5 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none resize-y" placeholder="Paste the recruiter or HR's most recent email here..."></textarea>
        <button id="btnGenerateFollowUp" class="mt-4 w-full px-6 py-3 bg-ink text-canvas hover:bg-ink/90 font-medium rounded-full text-sm transition-all cursor-pointer ripple-btn btn-press">
          Generate Follow-Up Reply →
        </button>
      </div>
    </div>

    <!-- Loading -->
    <div id="fuLoading" class="hidden text-center py-12 reveal">
      <div class="relative w-12 h-12 mx-auto mb-4">
        <div class="absolute inset-0 border-3 border-hairline rounded-full"></div>
        <div class="absolute inset-0 border-3 border-transparent border-t-accent-blue rounded-full animate-spin"></div>
      </div>
      <p class="text-sm text-ink font-medium">Analyzing the conversation thread…</p>
      <p class="text-xs text-mute mt-1">Crafting your context-aware reply.</p>
    </div>

    <!-- Result -->
    <div id="fuResult" class="hidden reveal">
      <div class="border border-hairline bg-canvas rounded-lg shadow-sm overflow-hidden">
        <div class="p-4 border-b border-hairline bg-canvas-soft-2 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
            <h2 class="text-sm font-semibold text-ink">Your Follow-Up Reply</h2>
          </div>
          <div class="flex gap-2">
            <button id="fuCopy" class="px-3.5 py-1.5 text-xs font-semibold rounded-full bg-accent-blue text-white hover:bg-accent-blue-deep transition-colors cursor-pointer">Copy</button>
            <button id="fuRegen" class="px-3.5 py-1.5 text-xs font-semibold rounded-full border border-hairline bg-canvas text-ink hover:bg-canvas-soft transition-colors cursor-pointer">Regenerate</button>
          </div>
        </div>
        <textarea id="fuResultText" class="w-full h-72 p-5 border-0 bg-canvas font-sans text-sm text-ink leading-relaxed resize-y outline-none" readonly></textarea>
        <div class="p-4 border-t border-hairline bg-canvas-soft-2 flex justify-between items-center">
          <span id="fuCaption" class="text-[10px] font-mono text-mute"></span>
          <button id="fuStartOver" class="text-[10px] text-mute hover:text-ink font-mono underline transition-colors cursor-pointer">Start fresh</button>
        </div>
      </div>

      <!-- Thread Display -->
      <div id="threadDisplay" class="border border-hairline bg-canvas rounded-lg shadow-sm p-5 reveal mt-5">
        <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">Conversation Thread</h3>
        <div id="threadMessages" class="space-y-3"></div>
      </div>
    </div>

    <!-- How It Works -->
    <div class="border border-hairline bg-canvas rounded-lg shadow-sm p-5 sm:p-6 reveal">
      <h2 class="text-sm font-semibold text-ink mb-4 flex items-center gap-2">
        <span class="w-5 h-5 rounded-full bg-accent-blue/10 flex items-center justify-center text-[10px] font-mono text-accent-blue">?</span>
        How This Works
      </h2>
      <div class="space-y-3 text-sm text-body leading-relaxed">
        <p><strong class="text-ink">1. Enter the context</strong> — Fill in your role, company, and target salary. Select the tone that matches your style.</p>
        <p><strong class="text-ink">2. Paste the recruiter's email</strong> — Copy the latest email you received from the recruiter or HR. The more context you provide, the better the reply.</p>
        <p><strong class="text-ink">3. Optionally add your previous email</strong> — If you've already sent them a message, paste it here so the AI understands the full conversation thread.</p>
        <p><strong class="text-ink">4. Generate</strong> — The tool sends your details to our AI engine (Gemini 2.5 Flash) which analyzes the conversation and crafts a context-aware reply using negotiation frameworks like anchoring, BATNA, and value-first positioning.</p>
        <p><strong class="text-ink">5. Review, copy, send</strong> — Read the generated reply, tweak if needed, copy it, and send it to your recruiter. You can regenerate for alternate versions.</p>
      </div>
      <div class="mt-4 pt-4 border-t border-hairline">
        <p class="text-xs text-mute">The AI uses the same negotiation engine as our main Salary Pitcher tool — Harvard Negotiation methodology + FBI tactics + market data anchoring. If the AI service is unavailable, a smart template-based fallback is used instead.</p>
      </div>
    </div>
  </div>
</Layout>

<script set:html={`window.__ROLES_FU__ = ${rolesJson};`} />
<script is:inline>
  (function () {
    const $ = (id) => document.getElementById(id);
    const fmt = (v) => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(v);

    let isGenerating = false;
    let typewriterTimer = null;

    function typewriterEffect(element, text, speed = 15, onComplete) {
      if (typewriterTimer) { clearTimeout(typewriterTimer); typewriterTimer = null; }
      element.value = "";
      element.classList.add("typewriter");
      let i = 0;
      function type() {
        if (i < text.length) {
          element.value += text.charAt(i);
          i++;
          typewriterTimer = setTimeout(type, speed);
        } else {
          element.classList.remove("typewriter");
          typewriterTimer = null;
          if (onComplete) onComplete();
        }
      }
      type();
    }

    function showError(msg) {
      const el = document.createElement("div");
      el.className = "text-xs text-error bg-error-soft p-3 rounded-md mt-3";
      el.textContent = msg;
      $("btnGenerateFollowUp").parentNode.appendChild(el);
      setTimeout(() => el.remove(), 4000);
    }

    async function generateReply() {
      if (isGenerating) return;
      isGenerating = true;

      const role = $("fuRole").value.trim();
      const company = $("fuCompany").value.trim();
      const target = $("fuTarget").value.trim();
      const tone = $("fuTone").value;
      const prevEmail = $("fuPreviousEmail").value.trim();
      const recruiterEmail = $("fuRecruiterEmail").value.trim();

      if (!role || !company) { showError("Please enter at least the role and company."); isGenerating = false; return; }
      if (!recruiterEmail) { showError("Please paste the recruiter's latest email."); isGenerating = false; return; }

      $("btnGenerateFollowUp").parentNode.classList.add("hidden");
      $("fuLoading").classList.remove("hidden");

      try {
        const toneName = $("fuTone").options[$("fuTone").selectedIndex].text;
        const combinedHrEmail = prevEmail
          ? `[My previous email]\n${prevEmail}\n\n[Recruiter's reply]\n${recruiterEmail}`
          : recruiterEmail;

        const payload = {
          role,
          company,
          location: "Remote",
          currentOffer: "",
          targetSalary: target,
          competingOffer: false,
          tone,
          achievement: "I have relevant experience and skills for this role and have consistently delivered strong results in my previous positions.",
          achievementDetail: "",
          hrReplyEmail: combinedHrEmail,
          lowRange: "",
          highRange: "",
          industry: "",
          companySize: "",
        };

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 30000);

        const response = await fetch("/api/generate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        clearTimeout(timeoutId);

        let replyBody = "";
        let isMock = true;

        if (response.ok) {
          const data = await response.json();
          replyBody = data.text;
          isMock = data.isMock || false;
        } else {
          const msg = `I'm reviewing your latest conversation with the recruiter at ${company} regarding the ${role} role. Based on the discussion so far, here's my recommended reply.\n\nThank you for your response. I've carefully considered the details you've shared about the ${role} position. I remain very interested in joining ${company} and contributing to the team's success. Based on my market research and the experience I bring, I believe we're close to a mutually beneficial agreement.\n\nI was hoping we could look at ${target ? fmt(parseInt(target)) : "a market-aligned figure"} — I'm confident this reflects both the value I'll deliver and current market conditions for this role.\n\nI'd be happy to discuss this further on a call this week. Thank you again for your time and consideration.`;
          replyBody = msg;
        }

        $("fuCaption").textContent = `${role} at ${company} · ${toneName} tone · ${isMock ? "Template-based" : "AI-generated"}`;

        typewriterEffect($("fuResultText"), replyBody, 15, function () {
          isGenerating = false;
        });

        // Build thread display
        const thread = $("threadMessages");
        let threadHtml = "";
        if (prevEmail) {
          threadHtml += `<div class="p-3 rounded-lg bg-canvas-soft-2 border border-hairline">
            <div class="flex items-center gap-2 mb-1">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-blue"></span>
              <span class="text-[10px] font-mono font-semibold text-ink">You (sent)</span>
              <span class="text-[9px] font-mono text-mute">Previously</span>
            </div>
            <p class="text-xs text-body whitespace-pre-wrap">${prevEmail.length > 200 ? prevEmail.substring(0, 200) + '...' : prevEmail}</p>
          </div>`;
        }
        threadHtml += `<div class="p-3 rounded-lg bg-canvas-soft-2 border border-hairline">
          <div class="flex items-center gap-2 mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-blue"></span>
            <span class="text-[10px] font-mono font-semibold text-ink">Recruiter / HR</span>
            <span class="text-[9px] font-mono text-mute">Latest</span>
          </div>
          <p class="text-xs text-body whitespace-pre-wrap">${recruiterEmail.length > 300 ? recruiterEmail.substring(0, 300) + '...' : recruiterEmail}</p>
        </div>`;
        threadHtml += `<div class="p-3 rounded-lg bg-accent-blue/5 border border-accent-blue/20">
          <div class="flex items-center gap-2 mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-blue"></span>
            <span class="text-[10px] font-mono font-semibold text-accent-blue">Your New Reply</span>
            <span class="text-[9px] font-mono text-mute">⬇ Ready to send</span>
          </div>
          <p class="text-xs text-body whitespace-pre-wrap">${replyBody.substring(0, 200)}...</p>
        </div>`;
        thread.innerHTML = threadHtml;

        $("fuLoading").classList.add("hidden");
        $("fuResult").classList.remove("hidden");
        $("fuResult").scrollIntoView({ behavior: "smooth", block: "start" });
      } catch (err) {
        showError("Something went wrong. Please try again.");
        $("fuLoading").classList.add("hidden");
        $("btnGenerateFollowUp").parentNode.classList.remove("hidden");
        isGenerating = false;
      }
    }

    $("btnGenerateFollowUp").addEventListener("click", generateReply);

    $("fuCopy").addEventListener("click", async function () {
      const textarea = $("fuResultText");
      try {
        await navigator.clipboard.writeText(textarea.value);
        this.textContent = "Copied!";
        setTimeout(() => { this.textContent = "Copy"; }, 2000);
      } catch {
        textarea.select();
        document.execCommand("copy");
        this.textContent = "Copied!";
        setTimeout(() => { this.textContent = "Copy"; }, 2000);
      }
    });

    $("fuRegen").addEventListener("click", generateReply);

    $("fuStartOver").addEventListener("click", function () {
      $("fuResult").classList.add("hidden");
      $("btnGenerateFollowUp").parentNode.classList.remove("hidden");
      $("fuRole").value = "";
      $("fuCompany").value = "";
      $("fuTarget").value = "";
      $("fuPreviousEmail").value = "";
      $("fuRecruiterEmail").value = "";
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  })();
</script>
