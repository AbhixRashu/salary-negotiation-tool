---
import Layout from "../../layouts/Layout.astro";
import { BLOG_POSTS } from "../../data/blog-posts";

export const prerender = true;

export async function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout title={post.metaTitle} description={post.metaDescription}>
  <article class="max-w-3xl mx-auto">
    <div class="mb-8">
      <a href="/blog" class="text-xs font-mono text-mute hover:text-ink transition-colors">&larr; Back to all guides</a>
    </div>

    <div class="blog-content" set:html={post.content}></div>

    <div class="mt-8 pt-6 border-t border-hairline">
      <a href="/blog" class="text-xs font-mono text-mute hover:text-ink transition-colors">&larr; Back to all guides</a>
    </div>
  </article>
</Layout>
