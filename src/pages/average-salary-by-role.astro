---
import Layout from "../layouts/Layout.astro";
import { ROLES, METRO_AREAS } from "../data/salaries";

// Extract unique categories for filter
const categories = Array.from(new Set(ROLES.map((r) => r.category)));
---

<Layout
  title="Average US Salaries by Role — Labor Market Salary Database"
  description="Explore average occupational salaries (median, 25th, 75th percentiles) for 100+ US roles, adjusted by metropolitan location. Data sourced from BLS."
>
  <div class="w-full space-y-12">
    <!-- Header -->
    <div
      class="text-center sm:text-left flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 reveal"
    >
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-ink mb-2">
          Average US Salary by Role
        </h1>
        <p class="text-sm text-body">
          Search occupational wage benchmarks for <strong class="text-ink"
            >500+ roles</strong
          >, adjusted by local cost-of-labor indices. <strong
            class="text-accent-blue">Click any row</strong
          > for detailed breakdown.
        </p>
      </div>
      <span
        class="inline-flex self-center sm:self-auto items-center gap-1.5 px-3 py-1 rounded-full border border-hairline bg-canvas text-xs font-mono text-mute"
      >
        Sourced: BLS Statistics
      </span>
    </div>

    <!-- Filters Panel -->
    <div
      class="border border-hairline bg-canvas p-6 rounded-lg shadow-sm reveal"
    >
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Search Input -->
        <div class="flex flex-col gap-1.5">
          <label
            for="tableSearch"
            class="text-xs font-semibold text-ink font-mono uppercase tracking-wider"
            >Search Roles</label
          >
          <input
            type="text"
            id="tableSearch"
            class="w-full px-3.5 py-2.5 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none"
            placeholder="Search by role name..."
          />
        </div>

        <!-- Category Filter -->
        <div class="flex flex-col gap-1.5">
          <label
            for="tableCategory"
            class="text-xs font-semibold text-ink font-mono uppercase tracking-wider"
            >Category</label
          >
          <select
            id="tableCategory"
            class="w-full px-3.5 py-2.5 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none"
          >
            <option value="">All Categories</option>
            {categories.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>

        <!-- Location Filter -->
        <div class="flex flex-col gap-1.5">
          <label
            for="tableLocation"
            class="text-xs font-semibold text-ink font-mono uppercase tracking-wider"
            >Location Adjustment</label
          >
          <select
            id="tableLocation"
            class="w-full px-3.5 py-2.5 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none"
          >
            {
              METRO_AREAS.map((m) => (
                <option value={m.id} data-mult={m.multiplier}>
                  {m.name}
                </option>
              ))
            }
          </select>
        </div>
      </div>
    </div>

    <!-- LIVE SALARY ANIMATED BAR CHART -->
    <div
      id="salaryChartSection"
      class="border border-hairline bg-canvas p-6 sm:p-8 rounded-lg shadow-sm reveal"
    >
      <div class="flex items-baseline justify-between mb-6">
        <div>
          <h2 class="text-lg font-semibold text-ink tracking-tight">
            Top 10 Salaries by Role
          </h2>
          <p class="text-xs text-mute font-mono mt-0.5">
            Median annual salary · Scroll to animate
          </p>
        </div>
        <span
          class="text-[10px] font-mono text-mute uppercase tracking-wider bg-canvas-soft px-2.5 py-1 rounded-full border border-hairline"
          >Live</span
        >
      </div>
      <div id="barChartContainer" class="space-y-3">
        <!-- Bars rendered via JS -->
      </div>
    </div>

    <!-- Salaries Table Card -->
    <div
      class="border border-hairline bg-canvas rounded-lg shadow-sm overflow-hidden"
    >
      <div class="overflow-x-auto w-full">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr
              class="bg-canvas-soft-2 border-b border-hairline text-[10px] font-mono uppercase tracking-wider text-mute"
            >
              <th class="px-6 py-4 font-semibold">Role Name</th>
              <th class="px-6 py-4 font-semibold">Category</th>
              <th class="px-6 py-4 font-semibold text-right">25th Percentile</th
              >
              <th class="px-6 py-4 font-semibold text-right">Median Salary</th>
              <th class="px-6 py-4 font-semibold text-right">75th Percentile</th
              >
            </tr>
          </thead>
          <tbody
            id="salariesTableBody"
            class="text-sm divide-y divide-hairline"
          >
            <!-- Rendered via Javascript client-side -->
          </tbody>
        </table>
      </div>
      <div
        class="p-6 border-t border-hairline bg-canvas-soft-2 flex justify-between items-center text-xs text-mute font-mono"
      >
        <span
          >Showing <span id="displayCount" class="font-semibold text-ink"
            >0</span
          > roles matching query</span
        >
        <span>All data adjusted by location indices</span>
      </div>
    </div>

    <!-- BLS Citation & Help Box -->
    <div
      class="p-5 border border-hairline rounded-lg bg-canvas text-xs text-body leading-relaxed max-w-2xl"
    >
      <p class="font-semibold text-ink mb-1">Data Methodology & BLS Citation</p>
      <p>
        Wage distributions are mathematically modeled based on national
        occupational aggregates published by the Bureau of Labor Statistics
        (BLS) Occupational Employment and Wage Statistics (OEWS) program. Local
        metrics are adjusted using cost-of-labor indices compiled from
        metropolitan economic analysis divisions.
      </p>
    </div>
  </div>
</Layout>

