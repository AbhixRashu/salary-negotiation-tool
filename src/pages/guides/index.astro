---
import Layout from "../../layouts/Layout.astro";

const guides = [
  {
    title: "How to Negotiate Total Compensation (Not Just Salary)",
    slug: "negotiate-total-compensation",
    description:
      "Master the full compensation package — base salary, equity, bonuses, benefits, and remote perks — using a unified negotiation framework.",
    readTime: "8 min read",
  },
  {
    title: "How to Respond to a Job Offer You Want to Negotiate",
    slug: "respond-to-job-offer-negotiate",
    description:
      "Step-by-step phone scripts, buy-time emails, and counter-offer templates for the first 48 hours after receiving a job offer.",
    readTime: "6 min read",
  },
  {
    title: "What to Negotiate Besides Salary in a Job Offer",
    slug: "what-to-negotiate-besides-salary",
    description:
      "Base salary won't budge? 12 high-value non-cash alternatives (signing bonus, PTO, remote days, title) with dollar estimates and scripts.",
    readTime: "6 min read",
  },
  {
    title: "How to Negotiate Salary With No Competing Offers",
    slug: "negotiate-salary-no-leverage",
    description:
      "No competing offer? No experience? Discover 6 real leverage sources that turn factual market data into a higher starting salary.",
    readTime: "6 min read",
  },
  {
    title: "How to Negotiate Salary for a Remote Job",
    slug: "negotiate-salary-remote-job",
    description:
      "Master remote location-based pay models, cost-of-living adjustments, home office stipends, and remote-specific counter scripts.",
    readTime: "6 min read",
  },
  {
    title: "How to Negotiate a Raise or Internal Promotion",
    slug: "negotiate-raise-promotion-current-job",
    description:
      "Specific playbooks, timing advice, and brag-document templates for asking your current manager for more pay without burning bridges.",
    readTime: "6 min read",
  },
  {
    title: "How to Negotiate Salary After a Job Offer",
    slug: "how-to-negotiate-salary-after-job-offer",
    description:
      "A comprehensive, step-by-step blueprint for negotiating your compensation package after receiving a formal job offer.",
    readTime: "6 min read",
  },
  {
    title: "How to Counter a Lowball Offer",
    slug: "how-to-counter-lowball-offer",
    description:
      "Learn how to turn a disappointing lowball offer into a constructive salary discussion without burning professional bridges.",
    readTime: "6 min read",
  },
  {
    title: "What Achievements Can Freshers List?",
    slug: "what-achievements-can-freshers-list",
    description:
      "A complete guide for new graduates and freshers on what achievements to write in salary negotiation — even without corporate work experience.",
    readTime: "4 min read",
  },
  {
    title: "How to Negotiate a Sign-On Bonus",
    slug: "how-to-negotiate-sign-on-bonus",
    description:
      "Complete guide to negotiating a signing bonus as part of your job offer, with scripts and market data for maximum impact.",
    readTime: "6 min read",
  },
  {
    title: "10 Salary Negotiation Mistakes to Avoid",
    slug: "salary-negotiation-mistakes",
    description:
      "Discover the most common salary negotiation mistakes that cost you thousands. Learn exactly what not to do.",
    readTime: "6 min read",
  },
  {
    title: "How to Answer Salary Expectations in Interviews",
    slug: "how-to-answer-salary-expectations",
    description:
      "Get the exact scripts to defer giving numbers during initial recruiter screening calls and maintain maximum leverage.",
    readTime: "6 min read",
  },
];
---

<Layout
  title="Salary Negotiation Guides — Expert Compensation Advice"
  description="Browse free, practical guides on negotiating job offers, countering lowball salary figures, and answering expectation questions."
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Guides", path: "/guides" },
  ]}
>
  <div class="max-w-3xl mx-auto w-full space-y-10">
    <!-- Header -->
    <div class="text-center sm:text-left space-y-3 reveal">
      <h1 class="text-3xl font-semibold tracking-tight text-ink">
        Salary Negotiation Guides
      </h1>
      <p class="text-sm text-body">
        Step-by-step checklists, script templates, and strategic advice to help
        you navigate job offers confidently.
      </p>
    </div>

    <!-- Guides List -->
    <div class="space-y-6 stagger-children reveal">
      {
        guides.map((g, i) => {
          const icons = ["💎", "⚡", "🎁", "🎯", "💻", "📈", "📝", "🛡️", "🎓", "💰", "❌", "🎯"];
          const iconLabels = ["Guide", "Guide", "Guide", "Guide", "Guide", "Guide", "Guide", "Guide", "Guide", "Guide", "Guide", "Guide"];
          const isPopular = i < 3;
          return (
            <div
              class="border border-hairline bg-canvas rounded-lg shadow-sm transition-all duration-300 card-hover tilt-card glow-border overflow-hidden relative lift-on-hover"
            >
              {isPopular && (
                <span class="absolute top-3 right-3 badge-pop text-[10px] font-mono font-semibold px-2.5 py-0.5 rounded-full bg-accent-blue text-white">
                  ⭐ Most Popular
                </span>
              )}
              <div class="p-6 sm:p-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">
                <div class="space-y-2 max-w-xl flex-1">
                  <div class="flex items-center gap-2">
                    <span class="text-lg" role="img" aria-label={iconLabels[i % iconLabels.length]}>{icons[i % icons.length]}</span>
                    <span class="text-[10px] font-mono font-semibold text-mute uppercase tracking-wider">
                      {g.readTime}
                    </span>
                  </div>
                  <h2 class="text-lg font-semibold text-ink">
                    <a
                      href={`/guides/${g.slug}`}
                      class="hover:text-accent-blue transition-colors"
                    >
                      {g.title}
                    </a>
                  </h2>
                  <p class="text-sm text-body leading-relaxed">
                    {g.description}
                  </p>
                  <div class="flex items-center gap-2 pt-1">
                    <span
                      class="w-1.5 h-1.5 rounded-full"
                      style="background: {colors[i]};"
                    />
                    <span class="text-[10px] font-mono text-mute">
                      {i === 0
                        ? "Beginner Friendly"
                        : i === 1
                          ? "Intermediate"
                          : i === 2
                            ? "Beginner"
                            : i === 3
                              ? "Advanced"
                              : i === 4
                                ? "All Levels"
                                : "Beginner"}
                    </span>
                  </div>
                </div>
                <a
                  href={`/guides/${g.slug}`}
                  class="shrink-0 px-5 py-2.5 bg-ink text-canvas hover:bg-ink/90 font-medium rounded-full text-xs transition-colors ripple-btn btn-press magnetic-btn"
                >
                  <span class="magnetic-inner">Read Guide →</span>
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Tool Quick Link -->
    <div
      class="border border-hairline bg-canvas p-6 rounded-lg shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6"
    >
      <div class="space-y-1.5 text-center sm:text-left">
        <h3 class="font-semibold text-sm text-ink">
          Ready to write your counter-proposal?
        </h3>
        <p class="text-xs text-body">
          Answer a few questions in our tool to get a tailored draft email
          instantly.
        </p>
      </div>
      <a
        href="/"
        class="px-6 py-2.5 bg-ink text-canvas hover:bg-ink/90 font-medium rounded-full text-xs transition-colors shrink-0 ripple-btn btn-press"
      >
        Generate Counter-Offer
      </a>
    </div>
  </div>
</Layout>
