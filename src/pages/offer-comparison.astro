---
import Layout from "../layouts/Layout.astro";
import { METRO_AREAS } from "../data/salaries";
const metroJson = JSON.stringify(METRO_AREAS);
---

<Layout
  title="Compare Job Offers Side-by-Side | Salary Pitcher"
  description="Compare job offers side-by-side. Adjust for cost of living, see total comp including equity and bonus, 5-year projections, and tax estimates."
>
  <div class="w-full space-y-8 max-w-5xl mx-auto">
    <div class="reveal">
      <h1 class="text-3xl font-semibold tracking-tight text-ink mb-2">
        Offer Comparison Tool
      </h1>
      <p class="text-sm text-body">
        Add up to 5 job offers and compare them side-by-side — base salary,
        equity, bonus, cost-of-living adjusted, 5-year projection, and more.
      </p>
    </div>

    <!-- Offer Form -->
    <div
      id="offerFormContainer"
      class="border border-hairline bg-canvas p-5 sm:p-6 rounded-lg shadow-sm reveal card-glow"
      style="position:relative;z-index:1"
    >
      <div class="flex items-center justify-between mb-4">
        <h2
          class="text-sm font-semibold text-ink tracking-tight flex items-center gap-2"
        >
          <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
          Add an Offer
        </h2>
        <span id="offerCount" class="text-xs font-mono text-mute"
          >0 / 5 offers</span
        >
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <div class="flex flex-col gap-1">
          <label for="offerCompany" class="text-[11px] font-mono text-mute">Company <span class="text-red-400">*</span></label>
          <input
            type="text"
            id="offerCompany"
            class="w-full px-3 py-2 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none"
            placeholder="e.g. Google"
            autocomplete="off"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label for="offerRole" class="text-[11px] font-mono text-mute">Job Title <span class="text-red-400">*</span></label>
          <input
            type="text"
            id="offerRole"
            class="w-full px-3 py-2 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none"
            placeholder="e.g. Software Engineer"
            autocomplete="off"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label for="offerBase" class="text-[11px] font-mono text-mute">Base Salary <span class="text-red-400">*</span></label>
          <input
            type="number"
            id="offerBase"
            class="w-full px-3 py-2 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none font-mono"
            placeholder="$ e.g. 120000"
            min="0"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label for="offerBonus" class="text-[11px] font-mono text-mute tooltip-container">
            Annual Bonus
            <span class="tooltip-text">Yearly performance/ guaranteed bonus</span>
          </label>
          <input
            type="number"
            id="offerBonus"
            class="w-full px-3 py-2 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none font-mono"
            placeholder="$ 0 if none"
            min="0"
            value="0"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label for="offerEquity" class="text-[11px] font-mono text-mute tooltip-container">
            Equity / Year
            <span class="tooltip-text">Annual RSU / stock value (total grant ÷ vest years)</span>
          </label>
          <input
            type="number"
            id="offerEquity"
            class="w-full px-3 py-2 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none font-mono"
            placeholder="$ 0 if none"
            min="0"
            value="0"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label for="offerSigning" class="text-[11px] font-mono text-mute tooltip-container">
            Signing Bonus
            <span class="tooltip-text">One-time sign-on bonus (added to Year 1 only)</span>
          </label>
          <input
            type="number"
            id="offerSigning"
            class="w-full px-3 py-2 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none font-mono"
            placeholder="$ 0 if none"
            min="0"
            value="0"
          />
        </div>
        <div class="flex gap-2 sm:col-span-2 lg:col-span-3">
          <select
            id="offerLocation"
            class="flex-1 px-3 py-2 border border-hairline rounded-md bg-canvas text-sm focus:border-accent-blue outline-none"
          >
            <option value="national">Remote / National Average</option>
            <option value="nyc">NYC Metro Area</option>
            <option value="sf">SF Bay Area</option>
            <option value="la">Los Angeles Area</option>
            <option value="chicago">Chicago Area</option>
            <option value="austin">Austin Area</option>
            <option value="seattle">Seattle Area</option>
            <option value="boston">Boston Area</option>
            <option value="denver">Denver Area</option>
            <option value="atlanta">Atlanta Area</option>
            <option value="dallas">Dallas-Fort Worth Area</option>
            <option value="miami">Miami Area</option>
          </select>
          <button
            id="btnAddOffer"
            class="px-5 py-2 bg-accent-blue text-white hover:bg-accent-blue-deep font-medium rounded-full text-sm transition-colors cursor-pointer shrink-0 ripple-btn btn-press"
            >+ Add</button
          >
        </div>
      </div>
      <p
        id="formError"
        class="hidden text-xs text-red-600 bg-red-50 dark:bg-red-950/20 dark:text-red-400 p-3 rounded-md mt-3 font-mono"
      >
      </p>
    </div>

    <!-- Toolbar -->
    <div id="toolbar" class="hidden flex items-center justify-between gap-3 reveal">
      <div class="flex items-center gap-2">
        <button id="btnClearAll" class="px-3 py-1.5 text-[11px] font-mono text-mute hover:text-red-500 border border-hairline rounded-full hover:border-red-200 transition-colors cursor-pointer">
          Clear All
        </button>
        <button id="btnExport" class="px-3 py-1.5 text-[11px] font-mono text-mute hover:text-ink border border-hairline rounded-full hover:border-hairline-strong transition-colors cursor-pointer">
          Copy Summary
        </button>
      </div>
      <span class="text-[10px] font-mono text-mute">Auto-saved</span>
    </div>

    <!-- Offer Cards -->
    <div id="offersList" class="space-y-4"></div>

    <!-- Empty State -->
    <div
      id="emptyState"
      class="text-center py-16 border border-dashed border-hairline rounded-lg reveal"
    >
      <p class="text-lg font-semibold text-ink mb-1">No offers yet</p>
      <p class="text-sm text-mute">
        Add at least 2 offers above to see a comparison.
      </p>
    </div>

    <!-- Comparison Sections -->
    <div id="comparisonSection" class="hidden space-y-6 reveal">

      <!-- Side-by-Side Table -->
      <div class="border border-hairline bg-canvas rounded-lg shadow-sm overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-hairline bg-canvas-soft-2">
          <h2 class="text-sm font-semibold text-ink flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
            Side-by-Side Comparison
          </h2>
        </div>
        <div class="overflow-x-auto">
          <table id="comparisonTable" class="w-full text-left text-sm">
            <thead>
              <tr
                class="bg-canvas-soft border-b border-hairline text-[10px] font-mono text-mute uppercase tracking-wider"
              >
                <th
                  class="px-4 py-3 font-semibold sticky left-0 bg-canvas-soft z-10"
                  >Metric</th
                >
              </tr>
            </thead>
            <tbody id="comparisonBody" class="divide-y divide-hairline"></tbody>
          </table>
        </div>
      </div>

      <!-- Bar Chart Visualization -->
      <div class="border border-hairline bg-canvas rounded-lg shadow-sm overflow-hidden reveal">
        <div class="p-4 sm:p-5 border-b border-hairline bg-canvas-soft-2">
          <h2 class="text-sm font-semibold text-ink flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
            Total Comp Comparison
          </h2>
        </div>
        <div id="barChart" class="p-5 space-y-4">
        </div>
      </div>

      <!-- 5-Year Projection -->
      <div class="border border-hairline bg-canvas rounded-lg shadow-sm overflow-hidden reveal">
        <div class="p-4 sm:p-5 border-b border-hairline bg-canvas-soft-2">
          <h2 class="text-sm font-semibold text-ink flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
            5-Year Projection
            <span class="tooltip-container">
              <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-canvas-soft-2 text-[10px] font-mono text-mute border border-hairline cursor-help">?</span>
              <span class="tooltip-text">Assumes 4-year vest with 1-year cliff. Equity refreshes not included.</span>
            </span>
          </h2>
        </div>
        <div class="overflow-x-auto">
          <table id="projectionTable" class="w-full text-left text-sm">
            <thead>
              <tr class="bg-canvas-soft border-b border-hairline text-[10px] font-mono text-mute uppercase tracking-wider">
                <th class="px-4 py-3 font-semibold sticky left-0 bg-canvas-soft z-10">Year</th>
              </tr>
            </thead>
            <tbody id="projectionBody" class="divide-y divide-hairline"></tbody>
          </table>
        </div>
      </div>

      <!-- Tax Estimate -->
      <div class="border border-hairline bg-canvas rounded-lg shadow-sm overflow-hidden reveal">
        <div class="p-4 sm:p-5 border-b border-hairline bg-canvas-soft-2">
          <h2 class="text-sm font-semibold text-ink flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
            Estimated Take-Home (Year 1)
            <span class="tooltip-container">
              <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-canvas-soft-2 text-[10px] font-mono text-mute border border-hairline cursor-help">?</span>
              <span class="tooltip-text">2026 federal tax brackets estimate. State tax not included. Signing bonus counted as income.</span>
            </span>
          </h2>
        </div>
        <div class="overflow-x-auto">
          <table id="taxTable" class="w-full text-left text-sm">
            <thead>
              <tr class="bg-canvas-soft border-b border-hairline text-[10px] font-mono text-mute uppercase tracking-wider">
                <th class="px-4 py-3 font-semibold sticky left-0 bg-canvas-soft z-10">Breakdown</th>
              </tr>
            </thead>
            <tbody id="taxBody" class="divide-y divide-hairline"></tbody>
          </table>
        </div>
      </div>

      <!-- Perks & Benefits -->
      <div class="border border-hairline bg-canvas rounded-lg shadow-sm overflow-hidden reveal">
        <div class="p-4 sm:p-5 border-b border-hairline bg-canvas-soft-2">
          <h2 class="text-sm font-semibold text-ink flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
            Perks &amp; Benefits
            <span class="tooltip-container">
              <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-canvas-soft-2 text-[10px] font-mono text-mute border border-hairline cursor-help">?</span>
              <span class="tooltip-text">Select benefits each offer includes. Estimated values added to total comp.</span>
            </span>
          </h2>
        </div>
        <div id="perksContainer" class="p-5">
        </div>
      </div>

      <!-- Ranking -->
      <div class="border border-hairline bg-canvas p-5 rounded-lg shadow-sm reveal">
        <h2 class="text-sm font-semibold text-ink mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
          Offer Ranking by Total Comp
        </h2>
        <div id="rankList" class="space-y-3"></div>
      </div>
    </div>
  </div>
</Layout>

<script set:html={`window.__METRO_DATA__ = ${metroJson};`} is:inline />
<script is:inline>
  (function () {
    const METRO = window.__METRO_DATA__ || [];

    const PERKS = [
      { id: 'health', label: 'Health Insurance', est: 6000 },
      { id: 'dental', label: 'Dental & Vision', est: 1200 },
      { id: '401k_match', label: '401(k) Match (avg $5k)', est: 5000 },
      { id: 'remote', label: 'Remote / WFH Stipend', est: 3000 },
      { id: 'pto', label: '20+ PTO Days', est: 4000 },
      { id: 'parental', label: 'Parental Leave', est: 2000 },
      { id: 'meals', label: 'Free Meals', est: 3000 },
      { id: 'wellness', label: 'Wellness / Gym', est: 1000 },
      { id: 'tuition', label: 'Tuition Reimb. ($5k+)', est: 5000 },
      { id: 'commute', label: 'Commuter Benefits', est: 1500 },
    ];

    const COLORS = ["#0070f3", "#7928ca", "#ff0080", "#50e3c2", "#f5a623"];
    const STORAGE_KEY = 'salaryp_offers';

    let offers = [];
    let editingIndex = -1;
    let perks = {}; // "0_health" -> true

    const $ = (id) => document.getElementById(id);

    function getMult(loc) {
      const m = METRO.find((x) => x.id === loc);
      return m ? m.multiplier : 1.0;
    }

    function getLocLabel(loc) {
      const m = METRO.find((x) => x.id === loc);
      return m ? m.name : "National";
    }

    function fmt(v) {
      return new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      }).format(v);
    }

    function fmtNum(v) {
      return new Intl.NumberFormat("en-US").format(v);
    }

    function calcScore(offer) {
      const total = offer.base + offer.bonus + offer.equity;
      const colAdj = total / getMult(offer.location);
      return Math.round(colAdj / 1000);
    }

    function totalComp(o) {
      return o.base + o.bonus + o.equity + o.signing;
    }

    function totalCompNoSigning(o) {
      return o.base + o.bonus + o.equity;
    }

    function getPerkTotal(idx) {
      return PERKS.reduce((sum, p) => {
        return sum + (perks[`${idx}_${p.id}`] ? p.est : 0);
      }, 0);
    }

    function taxEstimate(income) {
      let tax = 0;
      let remaining = income;
      const brackets = [
        { up: 11925, rate: 0.10 },
        { up: 48475, rate: 0.12 },
        { up: 103350, rate: 0.22 },
        { up: 197300, rate: 0.24 },
        { up: 250525, rate: 0.32 },
        { up: 626350, rate: 0.35 },
        { up: Infinity, rate: 0.37 },
      ];
      let prev = 0;
      for (const b of brackets) {
        if (remaining <= 0) break;
        const slice = Math.min(remaining, b.up - prev);
        tax += slice * b.rate;
        remaining -= slice;
        prev = b.up;
      }
      return Math.round(tax);
    }

    function saveToStorage() {
      try {
        const data = { offers, perks };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      } catch (_) {}
    }

    function loadFromStorage() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const data = JSON.parse(raw);
          if (data.offers && Array.isArray(data.offers)) offers = data.offers;
          if (data.perks) perks = data.perks;
        }
      } catch (_) {}
    }

    function render() {
      $("offerCount").textContent = offers.length + " / 5 offers";
      $("emptyState").classList.toggle("hidden", offers.length >= 2);
      $("comparisonSection").classList.toggle("hidden", offers.length < 2);
      $("toolbar").classList.toggle("hidden", offers.length === 0);
      renderCards();
      if (offers.length >= 2) {
        renderComparison();
        renderBarChart();
        renderProjection();
        renderTax();
        renderPerks();
        renderRanking();
      }
    }

    function renderCards() {
      const list = $("offersList");
      if (offers.length === 0) {
        list.innerHTML = "";
        return;
      }
      list.innerHTML = offers
        .map(
          (o, i) => `
        <div class="card-stack-enter border border-hairline bg-canvas rounded-lg shadow-sm p-4 sm:p-5" style="border-left: 4px solid ${COLORS[i % COLORS.length]};animation-delay:${i * 0.05}s">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs font-mono text-mute">#${i + 1}</span>
                <h3 class="text-base font-semibold text-ink tracking-tight truncate">${o.company}</h3>
                <span class="text-xs text-body">${o.role}</span>
                <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-mono bg-accent-blue/10 text-accent-blue border border-accent-blue/20">${getLocLabel(o.location)}</span>
              </div>
              <div class="flex flex-wrap gap-x-5 gap-y-1 mt-2 text-xs font-mono">
                <span class="text-body">Base: <strong class="text-ink">${fmt(o.base)}</strong></span>
                <span class="text-body">Bonus: <strong class="text-ink">${fmt(o.bonus)}</strong></span>
                <span class="text-body">Equity/yr: <strong class="text-ink">${fmt(o.equity)}</strong></span>
                <span class="text-body">Signing: <strong class="text-ink">${fmt(o.signing)}</strong></span>
              </div>
              <div class="flex gap-2 mt-2">
                <span class="text-xs font-mono text-body">Total: <strong class="text-accent-blue">${fmt(totalComp(o))}</strong></span>
                <span class="text-xs font-mono text-mute">·</span>
                <span class="text-xs font-mono text-body">COL-Adj: <strong class="text-ink">${fmt(Math.round(totalComp(o) / getMult(o.location)))}</strong></span>
              </div>
            </div>
            <div class="flex gap-1.5 shrink-0">
              <button class="edit-offer px-2.5 py-1.5 text-[10px] font-mono text-accent-blue hover:bg-accent-blue/5 rounded-md border border-accent-blue/20 transition-colors cursor-pointer" data-index="${i}">Edit</button>
              <button class="remove-offer px-2.5 py-1.5 text-[10px] font-mono text-red-500 hover:bg-red-50 dark:hover:bg-red-950/20 rounded-md border border-red-200 dark:border-red-900 transition-colors cursor-pointer" data-index="${i}">×</button>
            </div>
          </div>
        </div>
      `,
        )
        .join("");

      document.querySelectorAll(".remove-offer").forEach((btn) => {
        btn.addEventListener("click", function () {
          const idx = parseInt(this.dataset.index);
          offers.splice(idx, 1);
          render();
          saveToStorage();
        });
      });

      document.querySelectorAll(".edit-offer").forEach((btn) => {
        btn.addEventListener("click", function () {
          const idx = parseInt(this.dataset.index);
          const o = offers[idx];
          $("offerCompany").value = o.company;
          $("offerRole").value = o.role;
          $("offerBase").value = o.base;
          $("offerBonus").value = o.bonus;
          $("offerEquity").value = o.equity;
          $("offerSigning").value = o.signing;
          $("offerLocation").value = o.location;
          editingIndex = idx;
          $("btnAddOffer").textContent = "Update";
          $("offerFormContainer").scrollIntoView({
            behavior: "smooth",
            block: "center",
          });
        });
      });
    }

    function renderComparison() {
      const body = $("comparisonBody");
      const allBase = offers.map((o) => o.base);
      const allTotal = offers.map((o) => totalComp(o));
      const allTotalNoSign = offers.map((o) => totalCompNoSigning(o));
      const allPerkTotals = offers.map((_, i) => getPerkTotal(i));
      const allGrand = offers.map((o, i) => totalComp(o) + getPerkTotal(i));
      const allColAdj = offers.map((o, i) =>
        Math.round(allGrand[i] / getMult(o.location)),
      );
      const maxBase = Math.max(...allBase);
      const maxTotal = Math.max(...allTotal);

      const rows = [
        { label: "Base Salary", vals: allBase, fmt: true, max: maxBase },
        { label: "Annual Bonus", vals: offers.map((o) => o.bonus), fmt: true, max: Math.max(...offers.map((o) => o.bonus)) },
        { label: "Equity / Year", vals: offers.map((o) => o.equity), fmt: true, max: Math.max(...offers.map((o) => o.equity)) },
        { label: "Signing Bonus", vals: offers.map((o) => o.signing), fmt: true, max: Math.max(...offers.map((o) => o.signing)) },
        { label: "Total Comp", vals: allTotal, fmt: true, max: maxTotal, bold: true },
        { label: "Benefits (est.)", vals: allPerkTotals, fmt: true, max: Math.max(...allPerkTotals) },
        { label: "Grand Total", vals: allGrand, fmt: true, max: Math.max(...allGrand), bold: true, accent: true },
        { label: "Location", vals: offers.map((o) => getLocLabel(o.location)), fmt: false },
        { label: "COL Multiplier", vals: offers.map((o) => `${getMult(o.location).toFixed(2)}x`), fmt: false },
        { label: "COL-Adj. Grand Total", vals: allColAdj, fmt: true, max: Math.max(...allColAdj), bold: true, accent: true },
      ];

      const thead = document.querySelector("#comparisonTable thead tr");
      thead.innerHTML =
        `<th class="px-4 py-3 font-semibold sticky left-0 bg-canvas-soft z-10">Metric</th>` +
        offers
          .map(
            (o, i) =>
              `<th class="px-4 py-3 font-semibold text-right" style="color:${COLORS[i % COLORS.length]}">${o.company}</th>`,
          )
          .join("");

      body.innerHTML = rows
        .map((row) => {
          const bestVal = row.fmt
            ? Math.max(...row.vals.filter((v) => typeof v === "number"))
            : null;
          return `<tr class="hover:bg-canvas-soft/40 transition-colors">
          <td class="px-4 py-3 sticky left-0 bg-canvas z-10 text-xs text-body font-medium ${row.bold ? "font-semibold text-ink" : ""}">${row.label}</td>
          ${row.vals
            .map((v) => {
              const isBest =
                row.fmt && typeof v === "number" && v === bestVal && v > 0;
              const cls = row.bold
                ? "font-semibold text-ink"
                : row.accent && isBest
                  ? "font-semibold text-accent-blue"
                  : "text-body";
              const h =
                isBest && row.fmt
                  ? ' <span class="text-[9px] text-emerald-500 font-mono">BEST</span>'
                  : "";
              return `<td class="px-4 py-3 text-right font-mono text-sm ${cls}">${row.fmt ? fmt(v) : v}${h}</td>`;
            })
            .join("")}
        </tr>`;
        })
        .join("");
    }

    function renderBarChart() {
      const container = $("barChart");
      const totals = offers.map((o) => totalComp(o));
      const withPerks = offers.map((o, i) => totalComp(o) + getPerkTotal(i));
      const maxVal = Math.max(...withPerks);

      container.innerHTML = offers
        .map((o, i) => {
          const val = withPerks[i];
          const pct = maxVal > 0 ? (val / maxVal) * 100 : 0;
          return `
          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs">
              <span class="font-semibold text-ink truncate" style="color:${COLORS[i % COLORS.length]}">${o.company}</span>
              <span class="font-mono text-body">${fmt(val)}</span>
            </div>
            <div class="w-full h-3 bg-canvas-soft-2 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all duration-1000 ease-out" style="width:${pct}%;background:${COLORS[i % COLORS.length]};animation:barFill 1s cubic-bezier(0.16,1,0.3,1) forwards"></div>
            </div>
          </div>
        `;
        })
        .join("");
    }

    function renderProjection() {
      const body = $("projectionBody");
      const years = [1, 2, 3, 4, 5];

      const rows = years.map((y) => {
        const vals = offers.map((o) => {
          const baseBonus = o.base + o.bonus;

          if (y === 1) {
            return baseBonus + o.signing;
          }

          let equityVest = 0;
          if (y === 2) equityVest = o.equity * 0.25;
          else if (y === 3) equityVest = o.equity * 0.50;
          else if (y === 4) equityVest = o.equity * 0.75;
          else if (y === 5) equityVest = o.equity * 1.0;

          return baseBonus + equityVest;
        });

        const bestVal = Math.max(...vals);

        return {
          label: `Year ${y}${y === 1 ? ' (w/ signing)' : ''}`,
          vals,
          best: bestVal,
        };
      });

      const thead = document.querySelector("#projectionTable thead tr");
      thead.innerHTML =
        `<th class="px-4 py-3 font-semibold sticky left-0 bg-canvas-soft z-10">Year</th>` +
        offers
          .map(
            (o, i) =>
              `<th class="px-4 py-3 font-semibold text-right" style="color:${COLORS[i % COLORS.length]}">${o.company}</th>`,
          )
          .join("");

      body.innerHTML = rows
        .map((row) => {
          const totalVals = row.vals;
          const bestVal = Math.max(...totalVals);
          return `<tr class="hover:bg-canvas-soft/40 transition-colors">
          <td class="px-4 py-3 sticky left-0 bg-canvas z-10 text-xs font-medium text-body">${row.label}</td>
          ${row.vals
            .map((v) => {
              const isBest = v === bestVal && v > 0;
              return `<td class="px-4 py-3 text-right font-mono text-sm ${isBest ? 'font-semibold text-accent-blue' : 'text-body'}">${fmt(v)}${isBest ? ' <span class="text-[9px] text-emerald-500 font-mono">BEST</span>' : ''}</td>`;
            })
            .join("")}
        </tr>`;
        })
        .join("");
    }

    function renderTax() {
      const body = $("taxBody");
      const incomes = offers.map((o) => totalCompNoSigning(o) + o.signing);
      const taxes = incomes.map((i) => taxEstimate(i));
      const afterTax = incomes.map((i, idx) => i - taxes[idx]);

      const maxAfter = Math.max(...afterTax);

      const rows = [
        { label: "Gross Income (Yr 1)", vals: incomes, best: Math.max(...incomes) },
        { label: "Est. Federal Tax", vals: taxes },
        { label: "Est. Take-Home", vals: afterTax, best: maxAfter, bold: true },
      ];

      const thead = document.querySelector("#taxTable thead tr");
      thead.innerHTML =
        `<th class="px-4 py-3 font-semibold sticky left-0 bg-canvas-soft z-10">Breakdown</th>` +
        offers
          .map(
            (o, i) =>
              `<th class="px-4 py-3 font-semibold text-right" style="color:${COLORS[i % COLORS.length]}">${o.company}</th>`,
          )
          .join("");

      body.innerHTML = rows
        .map((row) => {
          return `<tr class="hover:bg-canvas-soft/40 transition-colors">
          <td class="px-4 py-3 sticky left-0 bg-canvas z-10 text-xs font-medium text-body ${row.bold ? "font-semibold text-ink" : ""}">${row.label}</td>
          ${row.vals
            .map((v) => {
              const isBest = row.best !== undefined && v === row.best;
              return `<td class="px-4 py-3 text-right font-mono text-sm ${isBest ? 'font-semibold text-accent-blue' : row.bold ? 'font-semibold text-ink' : 'text-body'}">${fmt(v)}${isBest ? ' <span class="text-[9px] text-emerald-500 font-mono">BEST</span>' : ''}</td>`;
            })
            .join("")}
        </tr>`;
        })
        .join("");
    }

    function renderPerks() {
      const container = $("perksContainer");
      if (offers.length === 0) { container.innerHTML = ""; return; }

      container.innerHTML = `
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="text-[10px] font-mono text-mute uppercase tracking-wider border-b border-hairline">
                <th class="pb-2 font-semibold">Perk</th>
                ${offers.map((o, i) => `<th class="pb-2 font-semibold text-center" style="color:${COLORS[i % COLORS.length]}">${o.company}</th>`).join("")}
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              ${PERKS.map((p) => `
                <tr class="hover:bg-canvas-soft/40 transition-colors">
                  <td class="py-2 pr-4 text-xs text-body tooltip-container">
                    ${p.label}
                    <span class="tooltip-text">Est. value: ${fmt(p.est)}/yr</span>
                  </td>
                  ${offers.map((_, i) => {
                    const checked = perks[`${i}_${p.id}`] || false;
                    return `<td class="py-2 text-center">
                      <input type="checkbox" class="perk-checkbox cursor-pointer" data-offer="${i}" data-perk="${p.id}" ${checked ? 'checked' : ''} />
                    </td>`;
                  }).join("")}
                </tr>
              `).join("")}
              <tr class="bg-canvas-soft-2/50 font-semibold">
                <td class="py-2 pr-4 text-xs text-ink">Total Perks Value</td>
                ${offers.map((_, i) => {
                  const total = getPerkTotal(i);
                  return `<td class="py-2 text-center font-mono text-sm ${total > 0 ? 'text-accent-blue' : 'text-mute'}">${total > 0 ? fmt(total) : '—'}</td>`;
                }).join("")}
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-[10px] font-mono text-mute mt-3">Check perks each offer includes. Estimated values added to grand total.</p>
      `;

      container.querySelectorAll(".perk-checkbox").forEach((cb) => {
        cb.addEventListener("change", function () {
          const oi = this.dataset.offer;
          const pk = this.dataset.perk;
          perks[`${oi}_${pk}`] = this.checked;
          saveToStorage();
          render();
        });
      });
    }

    function renderRanking() {
      const ranked = offers
        .map((o, i) => ({
          index: i,
          company: o.company,
          total: totalComp(o),
          grand: totalComp(o) + getPerkTotal(i),
          colAdj: Math.round((totalComp(o) + getPerkTotal(i)) / getMult(o.location)),
          score: calcScore(o),
        }))
        .sort((a, b) => b.grand - a.grand);

      $("rankList").innerHTML = ranked
        .map((r, rank) => {
          const medal =
            rank === 0
              ? "🥇"
              : rank === 1
                ? "🥈"
                : rank === 2
                  ? "🥉"
                  : `#${rank + 1}`;
          return `<div class="flex items-center justify-between p-3 rounded-lg border border-hairline bg-canvas-soft/50 card-stack-enter" style="animation-delay:${rank * 0.08}s">
          <div class="flex items-center gap-3 min-w-0">
            <span class="text-sm shrink-0">${medal}</span>
            <div class="min-w-0">
              <span class="text-sm font-semibold text-ink" style="color:${COLORS[r.index % COLORS.length]}">${r.company}</span>
              <span class="text-xs text-mute ml-2">${fmt(r.grand)} total</span>
            </div>
          </div>
          <div class="text-right shrink-0">
            <span class="text-sm font-semibold text-accent-blue font-mono">${fmt(r.colAdj)}</span>
            <span class="text-[10px] text-mute font-mono ml-1">COL-adj</span>
          </div>
        </div>`;
        })
        .join("");
    }

    function showFormError(msg) {
      const el = $("formError");
      el.textContent = msg;
      el.classList.remove("hidden");
      setTimeout(() => el.classList.add("hidden"), 3000);
    }

    function exportSummary() {
      if (offers.length < 2) return;
      let text = "📊 Offer Comparison Summary\n";
      text += "=".repeat(40) + "\n\n";

      offers.forEach((o, i) => {
        text += `${i + 1}. ${o.company} — ${o.role} (${getLocLabel(o.location)})\n`;
        text += `   Base: ${fmt(o.base)} | Bonus: ${fmt(o.bonus)} | Equity/yr: ${fmt(o.equity)} | Signing: ${fmt(o.signing)}\n`;
        text += `   Total: ${fmt(totalComp(o))} | COL-Adj: ${fmt(Math.round(totalComp(o) / getMult(o.location)))}\n`;
        text += `   Perks: ${fmt(getPerkTotal(i))} | Grand: ${fmt(totalComp(o) + getPerkTotal(i))}\n\n`;
      });

      text += "=".repeat(40) + "\n";
      text += "Generated by Salary Pitcher (salarypitcher.com)";

      navigator.clipboard.writeText(text).then(() => {
        const btn = $("btnExport");
        const orig = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = orig; }, 2000);
      }).catch(() => {
        showFormError("Could not copy to clipboard.");
      });
    }

    // Init
    loadFromStorage();

    if (offers.length > 0) {
      render();
    }

    $("btnAddOffer").addEventListener("click", function () {
      const company = $("offerCompany").value.trim();
      const role = $("offerRole").value.trim();
      const base = parseInt($("offerBase").value) || 0;
      const bonus = parseInt($("offerBonus").value) || 0;
      const equity = parseInt($("offerEquity").value) || 0;
      const signing = parseInt($("offerSigning").value) || 0;
      const location = $("offerLocation").value;

      if (!company) return showFormError("Please enter a company name.");
      if (!role) return showFormError("Please enter a job title.");
      if (base < 10000)
        return showFormError("Please enter a valid base salary.");
      if (!location) return showFormError("Please select a location.");

      const offer = { company, role, base, bonus, equity, signing, location };

      if (editingIndex >= 0) {
        offers[editingIndex] = offer;
        editingIndex = -1;
        this.textContent = "+ Add";
      } else {
        if (offers.length >= 5)
          return showFormError(
            "Maximum 5 offers allowed. Remove one to add another.",
          );
        offers.push(offer);
      }

      $("offerCompany").value = "";
      $("offerRole").value = "";
      $("offerBase").value = "";
      $("offerBonus").value = "0";
      $("offerEquity").value = "0";
      $("offerSigning").value = "0";
      $("offerLocation").value = "national";
      render();
      saveToStorage();
    });

    $("btnClearAll").addEventListener("click", function () {
      if (offers.length === 0) return;
      if (!confirm("Clear all offers?")) return;
      offers = [];
      perks = {};
      render();
      saveToStorage();
    });

    $("btnExport").addEventListener("click", exportSummary);
  })();
</script>
