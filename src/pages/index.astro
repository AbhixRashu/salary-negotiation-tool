---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Free Salary Negotiation Email Generator — Counter Offer in 2 Min | SalaryPitcher"
  description="Generate a personalized salary counter-offer email in 60 seconds. Free calculator, offer comparison, and proven negotiation scripts for US professionals."
>
  <div class="max-w-2xl mx-auto w-full py-4 sm:py-8">
    <!-- HERO SECTION -->
    <div class="text-center py-12 sm:py-16 relative overflow-hidden">
      <div class="relative z-10">
        <div
          class="reveal reveal-visible animate-fade-in-down inline-flex items-center gap-2 px-3 py-1 rounded-full border border-hairline bg-canvas text-xs font-mono text-mute mb-6"
        >
          <span class="w-2 h-2 rounded-full bg-accent-blue animate-pulse"
          ></span>
          Smart US Negotiation Assistant
        </div>
        <h1
          class="reveal reveal-visible animate-fade-in-up text-4xl sm:text-5xl font-semibold tracking-tight mb-6 leading-tight text-ink"
          style="animation-delay:0.15s"
        >
          Negotiate what you're actually worth.
        </h1>
        <p
          class="reveal reveal-visible animate-fade-in-up text-base sm:text-lg text-body mb-8 max-w-md mx-auto leading-relaxed"
          style="animation-delay:0.3s"
        >
          Answer a few quick questions to receive a confident, polite, and
          persuasive salary counter-offer draft in under two minutes.
        </p>
        <div class="flex justify-center mb-6">
          <div
            class="flex gap-3 flex-wrap justify-center reveal reveal-visible animate-fade-in-up"
            style="animation-delay:0.4s"
          >
            <div
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-hairline bg-canvas text-sm font-mono text-mute"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#00a86b"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                ></path></svg
              >
              <span>No login required</span>
            </div>
            <div
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-hairline bg-canvas text-sm font-mono text-mute"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#0070f3"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline></svg
              >
              <span>Takes 2 minutes</span>
            </div>
            <div
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-hairline bg-canvas text-sm font-mono text-mute"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#7928ca"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polygon
                  points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                ></polygon></svg
              >
              <span>AI-powered</span>
            </div>
          </div>
        </div>
        <div
          class="flex justify-center reveal reveal-visible animate-fade-in-up"
          style="animation-delay:0.55s"
        >
          <a
            href="/pitch-assistant"
            class="group inline-flex items-center gap-2 px-8 py-3.5 bg-ink text-canvas hover:bg-ink/90 font-medium rounded-full text-base transition-all duration-300 cursor-pointer card-hover tilt-card glow-border ripple-btn btn-press magnetic-btn"
            ><span class="magnetic-inner flex items-center gap-2"
              >Start Pitch Assistant <span
                class="group-hover:translate-x-0.5 transition-transform">→</span
              ></span
            ></a
          >
        </div>
      </div>
    </div>

    <!-- WHY NEGOTIATE? REASSURANCE CARD -->
    <div
      class="reveal border border-hairline bg-canvas rounded-lg p-5 sm:p-6 my-12 sm:my-16 text-center"
    >
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 text-xs font-mono font-semibold uppercase tracking-wider mb-3"
      >
        Why Negotiate?
      </div>
      <p
        class="text-sm sm:text-base text-body leading-relaxed max-w-lg mx-auto"
      >
        <strong class="text-ink"
          >Negotiating your offer is normal and expected.</strong
        > Employers rarely rescind over a polite counter — in fact, <strong
          class="text-ink">85% of employers expect you to negotiate</strong
        > and those who ask get <strong class="text-ink">7-20% more</strong> on average.
        If you don't ask, you leave money on the table.
      </p>
      <div
        class="flex flex-wrap justify-center gap-4 mt-4 text-xs text-mute font-mono"
      >
        <span>✓ Polite counters never backfire</span>
        <span>✓ Backed by market data</span>
        <span>✓ Takes 2 minutes</span>
      </div>
      <p class="text-[9px] text-mute/60 font-mono mt-4">
        Source: NACE 2024 Salary Negotiation Survey, HBR negotiation studies
      </p>
    </div>

    <!-- TOOLS & FEATURES SECTION -->
    <div class="reveal space-y-5 my-14 sm:my-18">
      <div class="text-center mb-3">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent-blue/10 text-accent-blue border border-accent-blue/20 text-sm font-mono font-semibold uppercase tracking-wider"
        >
          🛠 Your Free Tools
        </div>
        <p class="text-sm text-mute mt-2">
          Unique tools you won't find anywhere else — 100% free, no login
          required.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Follow-Up Email Generator -->
        <a
          href="/follow-up"
          class="group block border border-hairline bg-canvas rounded-xl p-5 sm:p-6 hover:border-accent-blue/50 hover:shadow-md hover:scale-[1.02] transition-all duration-200 cursor-pointer"
        >
          <div class="flex items-center gap-3 mb-3">
            <span
              class="w-10 h-10 rounded-xl bg-accent-blue/10 flex items-center justify-center text-xl group-hover:scale-110 transition-transform"
              >💬</span
            >
            <span
              class="text-xs font-mono font-semibold uppercase tracking-wider bg-purple-500/10 text-purple-600 border border-purple-500/20 px-2 py-0.5 rounded-full"
              >New</span
            >
          </div>
          <h3
            class="text-base font-semibold text-ink mb-1.5 group-hover:text-accent-blue transition-colors"
          >
            Follow-Up Email Generator
          </h3>
          <p class="text-sm text-body leading-relaxed">
            Already negotiating? Paste the recruiter's latest email and get an
            AI-written reply that continues your negotiation thread naturally. <strong
              class="text-ink">No competitor offers this.</strong
            >
          </p>
          <div
            class="mt-3 text-sm font-mono text-accent-blue group-hover:underline"
          >
            Try it →
          </div>
        </a>

        <!-- Negotiation Strategy Guide -->
        <a
          href="/negotiation-strategy"
          class="group block border border-hairline bg-canvas rounded-xl p-5 sm:p-6 hover:border-accent-blue/50 hover:shadow-md hover:scale-[1.02] transition-all duration-200 cursor-pointer"
        >
          <div class="flex items-center gap-3 mb-3">
            <span
              class="w-10 h-10 rounded-xl bg-accent-blue/10 flex items-center justify-center text-xl group-hover:scale-110 transition-transform"
              >🧠</span
            >
          </div>
          <h3
            class="text-base font-semibold text-ink mb-1.5 group-hover:text-accent-blue transition-colors"
          >
            Negotiation Strategy Guide
          </h3>
          <p class="text-sm text-body leading-relaxed">
            Answer 5 quick questions to get a <strong class="text-ink"
              >personalized playbook</strong
            > — talking points, scripts, timing strategy, and leverage analysis. Interactive,
            not a static article.
          </p>
          <div
            class="mt-3 text-sm font-mono text-accent-blue group-hover:underline"
          >
            Get your playbook →
          </div>
        </a>

        <!-- Offer Comparison Tool -->
        <a
          href="/offer-comparison"
          class="group block border border-hairline bg-canvas rounded-xl p-5 sm:p-6 hover:border-accent-blue/50 hover:shadow-md hover:scale-[1.02] transition-all duration-200 cursor-pointer"
        >
          <div class="flex items-center gap-3 mb-3">
            <span
              class="w-10 h-10 rounded-xl bg-accent-blue/10 flex items-center justify-center text-xl group-hover:scale-110 transition-transform"
              >📊</span
            >
          </div>
          <h3
            class="text-base font-semibold text-ink mb-1.5 group-hover:text-accent-blue transition-colors"
          >
            Offer Comparison Tool
          </h3>
          <p class="text-sm text-body leading-relaxed">
            Compare up to 5 job offers side-by-side — base salary, equity,
            bonus, cost-of-living adjusted. Free alternative to Levels.fyi's
            comparison feature.
          </p>
          <div
            class="mt-3 text-sm font-mono text-accent-blue group-hover:underline"
          >
            Compare offers →
          </div>
        </a>

        <!-- Salary Calculator -->
        <a
          href="/salary-calculator"
          class="group block border border-hairline bg-canvas rounded-xl p-5 sm:p-6 hover:border-accent-blue/50 hover:shadow-md hover:scale-[1.02] transition-all duration-200 cursor-pointer"
        >
          <div class="flex items-center gap-3 mb-3">
            <span
              class="w-10 h-10 rounded-xl bg-accent-blue/10 flex items-center justify-center text-xl group-hover:scale-110 transition-transform"
              >🧮</span
            >
          </div>
          <h3
            class="text-base font-semibold text-ink mb-1.5 group-hover:text-accent-blue transition-colors"
          >
            Salary Calculator
          </h3>
          <p class="text-sm text-body leading-relaxed">
            Convert hourly wage to annual salary instantly, estimate your
            <strong class="text-ink">federal net take-home pay</strong>, and
            visualize tax brackets. Real-time counter-up animations.
          </p>
          <div
            class="mt-3 text-sm font-mono text-accent-blue group-hover:underline"
          >
            Calculate your pay →
          </div>
        </a>

        <!-- Company Salary Explorer -->
        <a
          href="/company-salaries"
          class="group block border border-hairline bg-canvas rounded-xl p-5 sm:p-6 hover:border-accent-blue/50 hover:shadow-md hover:scale-[1.02] transition-all duration-200 cursor-pointer"
        >
          <div class="flex items-center gap-3 mb-3">
            <span
              class="w-10 h-10 rounded-xl bg-accent-blue/10 flex items-center justify-center text-xl group-hover:scale-110 transition-transform"
              >🏢</span
            >
          </div>
          <h3
            class="text-base font-semibold text-ink mb-1.5 group-hover:text-accent-blue transition-colors"
          >
            Company Salary Explorer
          </h3>
          <p class="text-sm text-body leading-relaxed">
            Browse compensation at <strong class="text-ink"
              >top companies</strong
            > — Google, Meta, Amazon, Apple, McKinsey & more. See base salary, equity,
            bonus, and perks for each role.
          </p>
          <div
            class="mt-3 text-sm font-mono text-accent-blue group-hover:underline"
          >
            Explore companies →
          </div>
        </a>
      </div>
    </div>
  </div>
</Layout>
