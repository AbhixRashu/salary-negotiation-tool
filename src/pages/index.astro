      screen.classList.remove("hidden");
    }

    function updateProgress() {
      const total = steps.length;
      const pct = Math.round(((currentStepIndex + 1) / total) * 100);
      progressStep.textContent = `Step ${currentStepIndex + 1} of ${total}`;
      progressPct.textContent = `${pct}%`;
      progressFill.style.width = `${pct}%`;
      const color = PROGRESS_COLORS[currentStepIndex] || '#0070f3';
      progressFill.style.background = `linear-gradient(90deg, ${color}, ${PROGRESS_COLORS[Math.min(currentStepIndex + 1, PROGRESS_COLORS.length - 1)]})`;

      // Step dots with animation
      const dotsContainer = document.getElementById('stepDots');
      if (dotsContainer) {
        const newDots = steps.map((s, i) =>
          `<span class="step-dot inline-block w-1.5 h-1.5 rounded-full ${i <= currentStepIndex ? 'opacity-100' : 'opacity-20'}" style="background:${i <= currentStepIndex ? (PROGRESS_COLORS[i] || '#0070f3') : 'var(--mute)'}"></span>`
        ).join('');
        if (dotsContainer.innerHTML !== newDots) {
          dotsContainer.innerHTML = newDots;
          // Animate active dot
          const activeDot = dotsContainer.querySelector('.step-dot.opacity-100:last-child');
          if (activeDot) {
            activeDot.classList.add('step-dot-activating');
            setTimeout(() => activeDot.classList.remove('step-dot-activating'), 500);
          }
        }
      }

      // Step icon with pop animation
      const stepIcon = document.getElementById('stepIcon');
      if (stepIcon) {
        const icon = STEP_ICONS[steps[currentStepIndex]?.id];
        if (icon) {
          stepIcon.textContent = icon;
          stepIcon.classList.remove('hidden');
          stepIcon.classList.add('step-icon-pop');
          setTimeout(() => stepIcon.classList.remove('step-icon-pop'), 400);
        } else {
          stepIcon.classList.add('hidden');
        }
      }

      // Animate progress counter numbers
      progressStep.classList.add('progress-counter-animating');
      progressPct.classList.add('progress-counter-animating');
      setTimeout(() => {
        progressStep.classList.remove('progress-counter-animating');
        progressPct.classList.remove('progress-counter-animating');
      }, 300);
    }

    function showError(msg) {
      stepError.textContent = msg;
      stepError.classList.remove("hidden");
    }

    function hideError() {
      stepError.classList.add("hidden");
    }

    // ─── STEP RENDERERS ────────────────────────────────────────────────────
    function renderStep(index) {
      const step = steps[index];
      if (!step) return;

      const card = document.getElementById('stepCard');
      if (card) {
        // Exit animation if coming from another step
        if (card.dataset.lastIndex !== undefined) {
          card.classList.add('step-card-exiting');
          card.addEventListener('animationend', function onExit() {
            card.classList.remove('step-card-exiting');
            card.removeEventListener('animationend', onExit);
            enterCard(card, index);
          }, { once: true });
        } else {
          enterCard(card, index);
        }
        card.dataset.lastIndex = index;
      }

      hideError();
      stepQuestion.textContent = step.question;
      stepHint.textContent = step.hint;
      stepQuestion.classList.add('question-animating');
      stepHint.classList.add('question-animating');

      btnBack.classList.toggle("hidden", index === 0);

      reassureLine.classList.toggle("hidden", index < 5);

      btnContinue.textContent =
        index === steps.length - 1 ? "Generate Pitch →" : "Continue";

      updateProgress();

      // Render input
      switch (step.type) {
        case "role-search":
          renderRoleSearch();
          break;
        case "select-location":
          renderLocationSelect();
          break;
        case "experience-select":
          renderExperienceSelect();
          break;
        case "industry-select":
          renderIndustrySelect();
          break;
        case "company-size-select":
          renderCompanySizeSelect();
          break;
        case "salary-slider":
          renderSalarySlider();
          break;
        case "text":
          renderTextInput(step.placeholder || "");
          break;
        case "numbers-offers":
          renderNumbersOffers();
          break;
        case "toggle-competing":
          renderToggleCompeting();
          break;
        case "textarea":
          renderTextarea(step.placeholder || "");
          break;
        case "hr-reply-textarea":
          renderHrReplyTextarea();
          break;
        case "tone-select":
          renderToneSelect();
          break;
        default:
          stepInputSlot.innerHTML = "";
          break;
      }

      // Trigger input animations
      setTimeout(() => {
        stepInputSlot.querySelectorAll('input, select, textarea, button[class*="option"]').forEach((el, i) => {
          el.style.animationDelay = `${0.15 + i * 0.04}s`;
          el.classList.add('input-animating');
        });
        // Auto-focus first input
        const firstInput = stepInputSlot.querySelector('input:not([type="hidden"]), textarea, select');
        if (firstInput && !firstInput.matches('[type="checkbox"], [type="radio"]')) {
          firstInput.classList.add('auto-focus-ring');
          setTimeout(() => firstInput.focus(), 100);
        }
      }, 50);

      const stepCardContainer = stepInputSlot.closest(".border");
      if (stepCardContainer) stepCardContainer.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    function enterCard(card, index) {
      card.classList.add('step-card-animating');
