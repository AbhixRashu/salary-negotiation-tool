    // ─── AUTO ACHIEVEMENT GENERATOR ──────────────────────────────────────
    function generateAutoAchievement(roleName) {
      const roleData = ROLES_DATA.find(r => r.role.toLowerCase() === roleName.toLowerCase());
      if (!roleData) return '';
      const skills = roleData.skills || [];
      const desc = roleData.description || '';
      const cat = roleData.category || '';

      const sk1 = skills[0] || 'specialized tools';
      const sk2 = skills[1] || 'analytical methods';
      const sk3 = skills[2] || 'industry best practices';
      const teamSize = cat === 'Healthcare' ? '12' : cat === 'Finance & Business' ? '8' : '10';
      const pctImprovement = cat === 'Technology' ? '40' : cat === 'Healthcare' ? '35' : '30';
      const revenueImpact = cat === 'Finance & Business' ? '$2.5M' : cat === 'Technology' ? '$1.8M' : '$1.2M';

      const templates = [
