---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Salary Pitcher — US Salary Negotiation Email Generator"
  description="Generate a custom, human-sounding salary negotiation email in under 2 minutes. Free, no login, market-backed."
>
  <div class="max-w-2xl mx-auto w-full py-4 sm:py-8">
    <!-- SCREEN 1: Hero / Landing -->
    <div
      id="screenHero"
      class="text-center py-12 sm:py-16 relative overflow-hidden"
    >
      <div class="mesh-gradient-container">
        <div class="mesh-gradient"></div>
        <div class="mesh-gradient-2"></div>
        <!-- Floating particles -->
        <div
          class="floating-particle"
          style="width:8px;height:8px;background:#0070f3;top:20%;left:10%;--drift-duration:18s;--drift-delay:0s;opacity:0.12"
        >
        </div>
        <div
          class="floating-particle"
          style="width:12px;height:12px;background:#7928ca;top:60%;left:80%;--drift-duration:22s;--drift-delay:2s;opacity:0.1"
        >
        </div>
        <div
          class="floating-particle"
          style="width:6px;height:6px;background:#50e3c2;top:30%;left:70%;--drift-duration:15s;--drift-delay:4s;opacity:0.15"
        >
        </div>
        <div
          class="floating-particle"
          style="width:10px;height:10px;background:#ff0080;top:70%;left:15%;--drift-duration:25s;--drift-delay:1s;opacity:0.08"
        >
        </div>
        <div
          class="floating-particle"
          style="width:5px;height:5px;background:#f9cb28;top:15%;left:50%;--drift-duration:20s;--drift-delay:3s;opacity:0.12"
        >
        </div>
        <div
          class="floating-particle"
          style="width:14px;height:14px;background:#007cf0;top:80%;left:55%;--drift-duration:28s;--drift-delay:5s;opacity:0.06"
        >
        </div>
      </div>
      <div class="relative z-10">
        <div
          class="reveal reveal-visible animate-fade-in-down inline-flex items-center gap-2 px-3 py-1 rounded-full border border-hairline bg-canvas text-xs font-mono text-mute mb-6"
        >
          <span class="w-2 h-2 rounded-full bg-accent-blue animate-pulse"
          ></span>
          Smart US Negotiation Assistant
        </div>
        <h1
          class="reveal reveal-visible animate-fade-in-up text-4xl sm:text-5xl font-semibold tracking-tight text-ink mb-6 leading-tight"
          style="animation-delay:0.15s"
        >
          Negotiate what you're actually worth.
        </h1>
        <p
          class="reveal reveal-visible animate-fade-in-up text-base sm:text-lg text-body mb-8 max-w-md mx-auto leading-relaxed"
          style="animation-delay:0.3s"
        >
          Answer a few quick questions to receive a confident, polite, and
          persuasive salary counter-offer draft in under two minutes.
        </p>
        <div
          class="flex justify-center reveal reveal-visible animate-fade-in-up mb-4"
          style="animation-delay:0.4s"
        >
          <div
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-hairline bg-canvas text-sm font-mono text-mute"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#10b981"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
              ></path></svg
            >
            <span>No login required — 100% free</span>
          </div>
        </div>
        <div
          class="flex justify-center reveal reveal-visible animate-fade-in-up"
          style="animation-delay:0.5s"
        >
          <button
            id="btnStart"
            class="px-8 py-3.5 bg-ink text-canvas hover:bg-ink/90 font-medium rounded-full text-base transition-all cursor-pointer card-hover tilt-card animate-glow-pulse ripple-btn btn-press magnetic-btn"
            ><span class="magnetic-inner">Start Pitch Assistant →</span></button
          >
        </div>
      </div>
    </div>

    <!-- SOCIAL PROOF TRUST BAR -->
    <div
      id="trustBar"
      class="grid grid-cols-3 gap-4 sm:gap-6 py-6 sm:py-8 px-2 reveal"
    >
      <div class="text-center">
        <div
          class="text-xl sm:text-2xl font-bold font-mono text-accent-blue tabular-nums trust-counter"
          data-target="10000"
          data-suffix="+"
        >
          0
        </div>
        <div
          class="text-[10px] sm:text-xs text-mute font-mono uppercase tracking-wider mt-1"
        >
          Offers Generated
        </div>
      </div>
      <div class="text-center border-x border-hairline">
        <div
          class="text-xl sm:text-2xl font-bold font-mono text-accent-blue tabular-nums trust-counter"
          data-target="95"
          data-suffix="%"
        >
          0
        </div>
        <div
          class="text-[10px] sm:text-xs text-mute font-mono uppercase tracking-wider mt-1"
        >
          Success Rate
        </div>
      </div>
      <div class="text-center">
        <div
          class="text-xl sm:text-2xl font-bold font-mono text-accent-blue tabular-nums trust-counter"
          data-target="100"
          data-suffix="+"
        >
          0
        </div>
        <div
          class="text-[10px] sm:text-xs text-mute font-mono uppercase tracking-wider mt-1"
        >
          Roles Covered
        </div>
      </div>
    </div>

    <!-- SCREEN 2: Conversational Flow -->
    <div id="screenConvo" class="hidden">
      <div class="mb-8">
        <div
          class="flex justify-between items-center text-xs font-mono text-mute mb-2"
        >
          <span id="progressStep">Step 1 of 9</span>
          <span id="progressPct">0%</span>
        </div>
        <div class="h-1 bg-hairline rounded-full overflow-hidden">
          <div
            id="progressFill"
            class="h-full bg-accent-blue transition-all duration-300"
            style="width:0%"
          >
          </div>
        </div>
      </div>
      <div
        class="border border-hairline bg-canvas p-6 sm:p-8 rounded-lg shadow-sm"
      >
        <h2
          id="stepQuestion"
          class="text-xl sm:text-2xl font-semibold text-ink tracking-tight mb-2 leading-snug"
        >
        </h2>
        <p id="stepHint" class="text-xs sm:text-sm text-mute mb-6"></p>
        <div id="stepInputSlot" class="mb-6"></div>
        <div
          id="stepError"
          class="hidden text-xs text-red-600 bg-red-50 dark:bg-red-950/20 dark:text-red-400 p-3 rounded-md mb-4 font-mono"
        >
        </div>
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4 border-t border-hairline"
        >
          <span
            id="reassureLine"
            class="hidden text-xs text-mute max-w-xs leading-relaxed italic"
          >
            Negotiating your offer is normal and expected — employers rarely
            rescind over a polite counter.
          </span>
          <div class="flex items-center gap-2 ml-auto">
            <button
              id="btnBack"
              class="hidden px-5 py-2.5 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft text-body hover:text-ink text-sm transition-colors cursor-pointer ripple-btn btn-press"
              >← Back</button
            >
            <button
              id="btnContinue"
              class="px-6 py-2.5 bg-ink text-canvas hover:bg-ink/90 font-medium rounded-full text-sm transition-all cursor-pointer ripple-btn btn-press"
              >Continue</button
            >
          </div>
        </div>
      </div>
    </div>

    <!-- SCREEN 3: Generating -->
    <div id="screenLoading" class="hidden text-center py-16">
      <div
        class="w-8 h-8 border-2 border-hairline border-t-accent-blue rounded-full animate-spin mx-auto mb-6"
      >
      </div>
      <h3 class="text-lg font-semibold text-ink mb-1">Crafting your pitch…</h3>
      <p class="text-sm text-mute">
        Analyzing market standards and structuring your achievements.
      </p>
    </div>

    <!-- SCREEN 4: Result -->
    <div id="screenResult" class="hidden">
      <div
        class="border border-hairline bg-canvas rounded-lg shadow-sm overflow-hidden"
      >
        <div
          class="p-6 border-b border-hairline flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-canvas-soft-2"
        >
          <div>
            <h2 class="text-lg font-semibold text-ink">
              Your Custom Counter-Offer Email
            </h2>
            <div class="flex flex-wrap gap-2 mt-1.5 items-center">
              <span
                id="badgeSource"
                class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold uppercase tracking-wider bg-canvas border border-hairline text-body"
              ></span>
              <span
                id="badgeTone"
                class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold uppercase tracking-wider bg-accent-blue/15 text-accent-blue border border-accent-blue/10"
              ></span>
            </div>
          </div>
          <div class="flex gap-2 w-full sm:w-auto">
            <button
              id="btnCopy"
              class="flex-1 sm:flex-none px-4 py-2 bg-accent-blue text-canvas hover:bg-accent-blue-deep font-semibold rounded-full text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer ripple-btn btn-press"
            >
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                ><rect x="9" y="9" width="13" height="13" rx="2" ry="2"
                ></rect><path
                  d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                ></path></svg
              >
              <span id="copyText">Copy</span>
            </button>
            <button
              id="btnRegen"
              class="flex-1 sm:flex-none px-4 py-2 bg-canvas hover:bg-canvas-soft-2 text-ink border border-hairline font-semibold rounded-full text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer ripple-btn btn-press"
            >
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                ><polyline points="23 4 23 10 17 10"></polyline><path
                  d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg
              >
              Regenerate
            </button>
          </div>
        </div>
        <div class="p-6">
          <textarea
            id="resultText"
            class="w-full h-80 p-4 border border-hairline rounded-md bg-canvas-soft font-sans text-sm text-ink leading-relaxed focus:border-accent-blue focus:ring-1 focus:ring-accent-blue resize-y outline-none"
            spellcheck="false"></textarea>
          <div
            class="mt-4 flex flex-col sm:flex-row justify-between items-center gap-3"
          >
            <span id="resultCaptionNote" class="text-xs font-mono text-mute"
            ></span>
            <button
              id="btnStartOver"
              class="text-xs text-mute hover:text-ink font-mono underline transition-colors cursor-pointer btn-press"
              >Start new negotiation →</button
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

