    // ─── CLIENT-SIDE EMAIL GENERATION ─────────────────────────────────────
    async function generateEmail() {
      if (isGenerating) return;
      isGenerating = true;

      showScreen(screenLoading);
      // Simulate slight delay for UX
      await new Promise((resolve) => setTimeout(resolve, 1200));

      try {
        // Try API first, fallback to client-side
        const payload = {
          role: answers.role,
          company: answers.company,
          location: answers.locationLabel || "Remote",
          currentOffer: answers.currentOffer,
          targetSalary: answers.targetSalary,
          competingOffer: answers.competingOffer,
          tone: answers.tone,
          achievement: answers.achievement,
          achievementDetail: "",
          hrReplyEmail: answers.hrReplyEmail || "",
          lowRange: String(answers.lowRange),
          highRange: String(answers.highRange),
          industry: answers.industry || "",
          companySize: answers.companySize || "",
        };

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 30000);

        const response = await fetch("/api/generate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });

        clearTimeout(timeoutId);

        if (response.ok) {
          const data = await response.json();
          displayResult(data.text, data.isMock || false);
          return;
        }
      } catch (err) {
        // API unavailable - will fall through to client-side
      }

      // Client-side generation (always works)
      const mockEmail = generateMockEmail();
      displayResult(mockEmail, true);
    }

    // ─── CONFETTI CELEBRATION ────────────────────────────────────────────
    function fireConfetti() {
      const colors = [
        "#0070f3",
        "#7928ca",
        "#ff0080",
        "#50e3c2",
        "#f5a623",
        "#ff4d4d",
        "#f9cb28",
      ];
      for (let i = 0; i < 60; i++) {
        const piece = document.createElement("div");
        piece.className = "confetti-piece";
        const color = colors[Math.floor(Math.random() * colors.length)];
        const size = 6 + Math.random() * 8;
        const isCircle = Math.random() > 0.5;
        piece.style.cssText = `
          left: ${Math.random() * 100}vw;
          width: ${size}px;
          height: ${isCircle ? size : size * 2.5}px;
          background: ${color};
          border-radius: ${isCircle ? "50%" : "2px"};
          --fall-duration: ${2 + Math.random() * 2}s;
          --fall-delay: ${Math.random() * 0.8}s;
          opacity: ${0.7 + Math.random() * 0.3};
          transform: rotate(${Math.random() * 360}deg);
        `;
        document.body.appendChild(piece);
        piece.addEventListener("animationend", () => piece.remove());
      }
    }

    // ─── TYPEWRITER EFFECT ──────────────────────────────────────────────
    let typewriterTimer = null;
    function typewriterEffect(element, text, speed = 15, onComplete) {
      if (typewriterTimer) {
        clearTimeout(typewriterTimer);
        typewriterTimer = null;
      }
      element.value = "";
      element.classList.add("typewriter");
      let i = 0;
      function type() {
        if (i < text.length) {
          element.value += text.charAt(i);
          i++;
          typewriterTimer = setTimeout(type, speed);
        } else {
          element.classList.remove("typewriter");
          typewriterTimer = null;
          if (onComplete) onComplete();
        }
      }
      type();
    }

    // ─── DISPLAY RESULT ───────────────────────────────────────────────────
    function displayResult(text, isMock) {
      // Store for polish feature
      lastGeneratedEmail = text;

      // Fire confetti celebration
      fireConfetti();

      // Update difficulty UI
      updateDifficultyUI();

      // Typewriter effect for the email — unblock isGenerating when done
      typewriterEffect(resultText, text, 15, function () {
        isGenerating = false;
      });

      badgeSource.textContent = isMock
        ? "📊 Market Estimate"
        : "🤖 AI Generated";
      badgeTone.textContent =
        TONES.find((t) => t.id === answers.tone)?.name || answers.tone;
      resultCaptionNote.textContent = `${answers.role} at ${answers.company} • ${answers.industryLabel || ""} • ${answers.companySizeLabel || ""} • ${answers.locationLabel || "Remote"}`;
      showScreen(screenResult);
    }

    // ─── NAVIGATION ───────────────────────────────────────────────────────
    function goToStep(index) {
      currentStepIndex = index;
      renderStep(currentStepIndex);
    }

    function goNext() {
      if (!validateStep(currentStepIndex)) return;

      if (currentStepIndex === steps.length - 1) {
        // Last step - generate
        generateEmail();
        return;
      }

      currentStepIndex++;
      renderStep(currentStepIndex);
    }

    function goBack() {
      if (currentStepIndex > 0) {
        currentStepIndex--;
        renderStep(currentStepIndex);
      }
    }

    // ─── COPY ──────────────────────────────────────────────────────────────
    btnCopy.addEventListener("click", async function () {
      try {
        await navigator.clipboard.writeText(resultText.value);
        copyText.textContent = "Copied!";
        // Success checkmark animation on the SVG
        const svg = this.querySelector("svg");
        if (svg) {
          svg.innerHTML = `<polyline points="20 6 9 17 4 12" stroke="currentColor" stroke-width="2.5" fill="none" class="animate-check"/>`;
        }
        setTimeout(() => {
          copyText.textContent = "Copy";
          if (svg) {
            svg.innerHTML = `<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>`;
          }
        }, 2000);
      } catch {
        // Fallback
        resultText.select();
        document.execCommand("copy");
        copyText.textContent = "Copied!";
        setTimeout(() => {
          copyText.textContent = "Copy";
        }, 2000);
      }
    });

    // ─── REGENERATE ────────────────────────────────────────────────────────
    btnRegen.addEventListener("click", generateEmail);

    // ─── AI POLISH ───────────────────────────────────────────────────────────
    lastGeneratedEmail = '';
    let lastPolishMode = '';

    function showPolishMenu() {
      const dropdown = $('polishDropdown');
      const isHidden = dropdown.classList.contains('hidden');
      if (isHidden) {
        dropdown.classList.remove('hidden');
        dropdown.classList.remove('closing');
      } else {
        dropdown.classList.add('closing');
        setTimeout(() => dropdown.classList.add('hidden'), 150);
      }
    }

    function hidePolishMenu() {
      const dropdown = $('polishDropdown');
      if (!dropdown.classList.contains('hidden')) {
        dropdown.classList.add('closing');
        setTimeout(() => dropdown.classList.add('hidden'), 150);
      }
    }

    async function polishEmail(mode) {
      const currentEmail = resultText.value.trim();
      if (!currentEmail || isGenerating) return;

      lastPolishMode = mode;
      const polishBtn = $('btnPolish');
      const btnText = polishBtn.querySelector('span') || polishBtn;
      const originalHtml = polishBtn.innerHTML;
      polishBtn.disabled = true;
      polishBtn.innerHTML = '<span class="spinner"></span><span>Polishing...</span>';
      polishBtn.classList.add('polish-loading');

      try {
        const response = await fetch('/api/polish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: currentEmail,
            mode: mode,
            context: `Role: ${answers.role}, Company: ${answers.company}, Target: $${parseInt(answers.targetSalary).toLocaleString()}, Tone: ${answers.tone}`
          })
        });

        if (response.ok) {
          const data = await response.json();
          lastGeneratedEmail = data.text;
          resultText.classList.add('polish-updating');
          typewriterEffect(resultText, data.text, 12, () => {
            resultText.classList.remove('polish-updating');
            isGenerating = false;
            badgeSource.textContent = data.isMock ? '🤖 AI Polished (Mock)' : '🤖 AI Polished';
          });
        } else {
          throw new Error('Polish failed');
        }
      } catch (err) {
        // Fallback to mock polish
        const polished = generateMockPolish(currentEmail, mode);
        lastGeneratedEmail = polished;
        resultText.classList.add('polish-updating');
        typewriterEffect(resultText, polished, 12, () => {
          resultText.classList.remove('polish-updating');
          isGenerating = false;
          badgeSource.textContent = '🤖 AI Polished (Mock)';
        });
      } finally {
        polishBtn.disabled = false;
        polishBtn.innerHTML = originalHtml;
        hidePolishMenu();
      }
    }

    function generateMockPolish(email, mode) {
      const lines = email.split('\n').filter(l => l.trim());
      const closing = lines.pop() || 'Best,\n[Your Name]';
      const body = lines.slice(1).join('\n');

      const transforms = {
        'more-assertive': (b) => b
          .replace(/I (think|believe|would like to|hope to)/gi, '')
          .replace(/I am (confident|sure) that/gi, 'My baseline is')
          .replace(/would (love|like) to/gi, 'need to')
          .replace(/could we/gi, 'we need to')
          .replace(/I was hoping/gi, 'I require')
          + '\n\nI\'m ready to sign once we align here.',
        'warmer-tone': (b) => 'I truly appreciate the offer and have enjoyed our conversations.\n\n' + b
          .replace(/I (require|need)/gi, 'I\'d love to')
          .replace(/my baseline is/gi, 'I was hoping we could')
          .replace(/I require/gi, 'would it be possible to')
          + '\n\nI\'m confident we can find something that works for both of us.',
        'shorten': (b) => {
          const sentences = b.split('. ').filter(s => s.trim());
          return sentences.slice(0, 4).join('. ') + '.';
        },
        'expand-details': (b) => b + '\n\nThis impact was achieved while leading a cross-functional team of 8 and delivering 3 weeks ahead of schedule — the kind of execution I\'ll bring to this role from day one.',
        'add-market-data': (b) => b + '\n\nBased on current market data for this role in this metro, the 75th percentile aligns with my target — this isn\'t a request, it\'s market reality.',
        'fix-grammar': (b) => b
          .replace(/\s+/g, ' ')
          .replace(/\.\s*\./g, '.')
          .replace(/,\s*,/g, ',')
          .replace(/I\s+I/gi, 'I')
          .trim()
      };

      const transform = transforms[mode] || transforms['fix-grammar'];
      return 'Hi [Hiring Manager Name],\n\n' + transform(body) + '\n\n' + closing;
    }

    // Polished dropdown event listeners
    document.addEventListener('click', function (e) {
      const polishBtn = $('btnPolish');
      const dropdown = $('polishDropdown');
      if (polishBtn && dropdown) {
        if (polishBtn.contains(e.target)) {
          e.stopPropagation();
          showPolishMenu();
        } else if (!dropdown.contains(e.target)) {
          hidePolishMenu();
        }
      }
      // Polished option clicks
      if (e.target.closest('.polish-option')) {
        const mode = e.target.closest('.polish-option').dataset.mode;
        if (mode) polishEmail(mode);
      }
    });

    // ─── START OVER ────────────────────────────────────────────────────────
    btnStartOver.addEventListener("click", function () {
      // Reset answers
      Object.assign(answers, {
        role: "",
        isCustomRole: false,
        location: "",
        locationLabel: "",
        experience: "",
        experienceLabel: "",
        industry: "",
        industryLabel: "",
        companySize: "",
        companySizeLabel: "",
        suggestedMedian: 0,
        adjustedMedian: 0,
        lowRange: 0,
        highRange: 0,
        company: "",
        currentOffer: "",
        targetSalary: "",
        competingOffer: "no",
        hrReplyEmail: "",
        achievement: "",
        tone: "",
      });
      currentStepIndex = 0;
      showScreen(screenHero);
    });

    // ─── START BUTTON ──────────────────────────────────────────────────────
    $("btnStart").addEventListener("click", function () {
      showScreen(screenConvo);
      currentStepIndex = 0;
      renderStep(0);
    });

    // ─── CONTINUE / BACK BUTTONS ───────────────────────────────────────────
    btnContinue.addEventListener("click", goNext);
    btnBack.addEventListener("click", goBack);

    // ─── TRUST COUNTER ANIMATION ──────────────────────────────────────────
    function initTrustCounters() {
      const counters = document.querySelectorAll(".trust-counter");
      if (counters.length === 0) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const target = parseInt(el.dataset.target);
              const suffix = el.dataset.suffix || "";
              const duration = 1500;
              const startTime = performance.now();

              function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                const current = Math.round(target * eased);
                el.textContent = current.toLocaleString() + suffix;
                if (progress < 1) {
                  requestAnimationFrame(update);
                } else {
                  el.textContent = target.toLocaleString() + suffix;
                }
              }
              requestAnimationFrame(update);
              observer.unobserve(el);
            }
          });
        },
        { threshold: 0.5 },
      );

      counters.forEach((c) => observer.observe(c));
    }

    // ─── KEYBOARD SUPPORT ──────────────────────────────────────────────────
    document.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && !screenConvo.classList.contains("hidden")) {
        const active = document.activeElement;
        if (
          active &&
          (active.tagName === "TEXTAREA" || active.tagName === "INPUT")
        ) {
          // Don't submit on enter in textarea or multi-line inputs
          if (active.id === "achievementInput" || active.id === "hrReplyInput")
            return;
        }
        e.preventDefault();
        goNext();
      }
      if (e.key === "Escape" && !btnBack.classList.contains("hidden")) {
        goBack();
      }
    });
    initTrustCounters(); // Initialize scroll-triggered trust counter animation
  })();
</script>
