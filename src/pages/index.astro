      searchInput.addEventListener("input", function () {
        const q = this.value.toLowerCase().trim();
        if (!q) {
          dropdown.classList.add("hidden");
          return;
        }
        const matches = ROLES_DATA.filter((r) =>
          r.role.toLowerCase().includes(q),
        ).slice(0, 15);
        if (matches.length === 0) {
          dropdown.classList.add("hidden");
          return;
        }
        dropdown.innerHTML = matches
          .map(
            (r) =>
              `<div class="px-3.5 py-2 hover:bg-canvas-soft-2 cursor-pointer text-sm text-ink border-b border-hairline last:border-b-0 transition-colors" data-role="${r.role}" data-median="${r.median}" data-low="${r.low}" data-high="${r.high}">${r.role}</div>`,
          )
          .join("");
        dropdown.classList.remove("hidden");
      });

      // Select from dropdown
      dropdown.addEventListener("click", function (e) {
        const item = e.target.closest("[data-role]");
        if (!item) return;
        const role = item.dataset.role;
        searchInput.value = role;
        answers.role = role;
        answers.isCustomRole = false;
        answers.suggestedMedian = parseFloat(item.dataset.median);
        answers.lowRange = parseFloat(item.dataset.low);
        answers.highRange = parseFloat(item.dataset.high);
        dropdown.classList.add("hidden");
      });

      // Close dropdown on outside click
      document.addEventListener("click", function closeDrop(e) {
        if (
          !e.target.closest("#roleSearchInput") &&
          !e.target.closest("#roleDropdown")
        ) {
          dropdown.classList.add("hidden");
          document.removeEventListener("click", closeDrop);
        }
      });

      // Custom role toggle
      btnCustom.addEventListener("click", function () {
        customInput.classList.toggle("hidden");
        customField.focus();
      });

      customField.addEventListener("input", function () {
        if (this.value.trim()) {
          answers.role = this.value.trim();
          answers.isCustomRole = true;
          answers.suggestedMedian = 85000;
          answers.lowRange = 65000;
          answers.highRange = 110000;
