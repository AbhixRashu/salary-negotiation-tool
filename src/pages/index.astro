    // ─── VALIDATION ────────────────────────────────────────────────────────
    function validateStep(index) {
      const step = steps[index];
      if (!step) return true;

      switch (step.id) {
        case "role":
          if (!answers.role.trim()) {
            showError("Please select or enter your job title.");
            return false;
          }
          return true;
        case "location":
          if (!answers.location) {
            showError("Please select your metro area.");
            return false;
          }
          return true;
        case "experience":
          if (!answers.experience) {
            showError("Please select your experience level.");
            return false;
          }
          return true;
        case "salaryRange":
          if (!answers.targetSalary || parseInt(answers.targetSalary) <= 0) {
            showError("Please adjust the salary slider.");
            return false;
          }
          return true;
        case "company":
          if (!answers.company.trim()) {
            showError("Please enter the company name.");
            return false;
          }
          return true;
        case "offers":
          if (!answers.currentOffer.trim() && !answers.targetSalary.trim()) {
            showError("Please enter at least one salary number.");
            return false;
          }
          return true;
        case "competing":
          return true;
        case "achievement":
          if (!answers.achievement.trim()) {
            showError("Please describe a key achievement.");
            return false;
          }
          return true;
        case "tone":
          if (!answers.tone) {
            showError("Please select a communication tone.");
            return false;
          }
          return true;
        default:
          return true;
      }
    }

    // ─── CLIENT-SIDE MOCK EMAIL GENERATOR ─────────────────────────────────
    function generateMockEmail() {
      const greeting = "Hi [Hiring Manager Name],";
      const closing = "Best,\n\n[Your Name]";

      const formattedLow = fmt(answers.lowRange).replace("$", "");
      const formattedHigh = fmt(answers.highRange).replace("$", "");
      const formattedRange =
        answers.lowRange && answers.highRange
          ? `$${formattedLow} to $${formattedHigh}`
          : "typical bands for this role";

      const locationText = (answers.locationLabel || "")
        .toLowerCase()
        .includes("remote")
        ? "for national average roles"
        : `in the ${answers.locationLabel || "your area"}`;

      const achievementSentence =
        answers.achievement.length > 5
          ? `particularly my work in ${answers.achievement.replace(/\.$/, "")}`
          : "my background and technical skills";

      const formattedTarget = answers.targetSalary
        ? `$${parseInt(answers.targetSalary).toLocaleString()}`
        : "$125,000";

      let body = "";

      if (answers.tone === "confident-polite") {
        body = `Thanks for extending the offer to join ${answers.company} as a ${answers.role}. I am excited about the team's vision and the chance to contribute.

Before finalizing, I wanted to discuss the base salary. Typical market ranges for a ${answers.role} ${locationText} run between ${formattedRange}. Considering this data alongside the specific value I plan to bring—${achievementSentence}—I would like to request a base salary of ${formattedTarget}.

${
  answers.competingOffer === "yes"
    ? `I have a competing offer at a comparable level, but ${answers.company} is my clear first choice. If we can close this gap, I'm ready to sign this week.`
    : `I believe this target represents a fair alignment with my qualifications and will allow me to fully focus on delivering results from day one.`
}

Are you open to discussing this? I am happy to hop on a call this week to align.`;
      } else if (answers.tone === "assertive") {
        body = `I appreciate the offer to join ${answers.company} as a ${answers.role}. I am very interested in the project roadmap.

Regarding the base salary, I have evaluated the initial offer against market rates. Typical compensation for comparable ${answers.role} positions ${locationText} sits between ${formattedRange}. In light of my background—especially ${achievementSentence}—I am looking for a base salary of ${formattedTarget} to finalize our agreement.

${
  answers.competingOffer === "yes"
    ? `I have another active offer at this level, but because ${answers.company} is my top choice, I prefer to sign here if we can meet this baseline.`
    : `This compensation reflects both my track record of delivery and the responsibilities of the role.`
}

Let me know if we can connect briefly to finalize this. I am happy to hop on a call this week.`;
      } else {
        body = `Thank you so much for the offer to join ${answers.company} as a ${answers.role}! I have really enjoyed our conversations and am very enthusiastic about working together.

I wanted to check if there is some flexibility around the base salary. Based on market standards for a ${answers.role} ${locationText} (typically ${formattedRange}) and reflecting my background—especially ${achievementSentence}—I was hoping we could look closer to ${formattedTarget}.

${
  answers.competingOffer === "yes"
    ? `I do have another active offer at the moment, but my preference is strongly for this team. I want to find a package that works well for both of us.`
    : `I am very open to discussing how we can structure this to reach a mutually beneficial agreement.`
}

Let me know if you have some time. I am happy to hop on a call this week to talk through the details.`;
      }

      return `${greeting}\n\n${body}\n\n${closing}`;
    }

    // ─── CLIENT-SIDE EMAIL GENERATION ─────────────────────────────────────
    async function generateEmail() {
      if (isGenerating) return;
      isGenerating = true;

      showScreen(screenLoading);
      // Simulate slight delay for UX
      await new Promise((resolve) => setTimeout(resolve, 1200));

      try {
        // Try API first, fallback to client-side
        const payload = {
          role: answers.role,
          company: answers.company,
          location: answers.locationLabel || "Remote",
          currentOffer: answers.currentOffer,
          targetSalary: answers.targetSalary,
          competingOffer: answers.competingOffer,
          tone: answers.tone,
          achievement: answers.achievement,
          achievementDetail: "",
          lowRange: String(answers.lowRange),
          highRange: String(answers.highRange),
        };

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 3000);

        const response = await fetch("/api/generate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });

        clearTimeout(timeoutId);

        if (response.ok) {
          const data = await response.json();
          displayResult(data.text, data.isMock || false);
          return;
        }
      } catch (err) {
        // API unavailable - will fall through to client-side
      }

      // Client-side generation (always works)
      const mockEmail = generateMockEmail();
      displayResult(mockEmail, true);
      isGenerating = false;
    }

    // ─── CONFETTI CELEBRATION ────────────────────────────────────────────
    function fireConfetti() {
      const colors = [
        "#0070f3",
        "#7928ca",
        "#ff0080",
        "#50e3c2",
        "#f5a623",
        "#ff4d4d",
        "#f9cb28",
      ];
      for (let i = 0; i < 60; i++) {
        const piece = document.createElement("div");
        piece.className = "confetti-piece";
        const color = colors[Math.floor(Math.random() * colors.length)];
        const size = 6 + Math.random() * 8;
        const isCircle = Math.random() > 0.5;
        piece.style.cssText = `
          left: ${Math.random() * 100}vw;
          width: ${size}px;
          height: ${isCircle ? size : size * 2.5}px;
          background: ${color};
          border-radius: ${isCircle ? "50%" : "2px"};
          --fall-duration: ${2 + Math.random() * 2}s;
          --fall-delay: ${Math.random() * 0.8}s;
          opacity: ${0.7 + Math.random() * 0.3};
          transform: rotate(${Math.random() * 360}deg);
        `;
        document.body.appendChild(piece);
        piece.addEventListener("animationend", () => piece.remove());
      }
    }

    // ─── TYPEWRITER EFFECT ──────────────────────────────────────────────
    function typewriterEffect(element, text, speed = 15) {
      element.value = "";
      element.classList.add("typewriter");
      let i = 0;
      function type() {
        if (i < text.length) {
          element.value += text.charAt(i);
          i++;
          setTimeout(type, speed);
        } else {
          element.classList.remove("typewriter");
        }
      }
      type();
    }

    // ─── DISPLAY RESULT ───────────────────────────────────────────────────
    function displayResult(text, isMock) {
      // Fire confetti celebration
      fireConfetti();

      // Typewriter effect for the email
      typewriterEffect(resultText, text);

      badgeSource.textContent = isMock
        ? "📊 Market Estimate"
        : "🤖 AI Generated";
      badgeTone.textContent =
        TONES.find((t) => t.id === answers.tone)?.name || answers.tone;
      resultCaptionNote.textContent = `Based on ${answers.role} in ${answers.locationLabel || "Remote"} • ${answers.experienceLabel || "Mid-level"}`;
      showScreen(screenResult);
    }

    // ─── NAVIGATION ───────────────────────────────────────────────────────
    function goToStep(index) {
      currentStepIndex = index;
      renderStep(currentStepIndex);
    }

    function goNext() {
      if (!validateStep(currentStepIndex)) return;

      if (currentStepIndex === steps.length - 1) {
        // Last step - generate
        generateEmail();
        return;
      }

      currentStepIndex++;
      renderStep(currentStepIndex);
    }

    function goBack() {
      if (currentStepIndex > 0) {
        currentStepIndex--;
        renderStep(currentStepIndex);
      }
    }

    // ─── COPY ──────────────────────────────────────────────────────────────
    btnCopy.addEventListener("click", async function () {
      try {
        await navigator.clipboard.writeText(resultText.value);
        copyText.textContent = "Copied!";
        // Success checkmark animation on the SVG
        const svg = this.querySelector("svg");
        if (svg) {
          svg.innerHTML = `<polyline points="20 6 9 17 4 12" stroke="currentColor" stroke-width="2.5" fill="none" class="animate-check"/>`;
        }
        setTimeout(() => {
          copyText.textContent = "Copy";
          if (svg) {
            svg.innerHTML = `<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>`;
          }
        }, 2000);
      } catch {
        // Fallback
        resultText.select();
        document.execCommand("copy");
        copyText.textContent = "Copied!";
        setTimeout(() => {
          copyText.textContent = "Copy";
        }, 2000);
      }
    });

    // ─── REGENERATE ────────────────────────────────────────────────────────
    btnRegen.addEventListener("click", generateEmail);

    // ─── START OVER ────────────────────────────────────────────────────────
    btnStartOver.addEventListener("click", function () {
      // Reset answers
      Object.assign(answers, {
        role: "",
        isCustomRole: false,
        location: "",
        locationLabel: "",
        experience: "",
        experienceLabel: "",
        suggestedMedian: 0,
        adjustedMedian: 0,
        lowRange: 0,
        highRange: 0,
        company: "",
        currentOffer: "",
        targetSalary: "",
        competingOffer: "no",
        achievement: "",
        tone: "",
      });
      currentStepIndex = 0;
      showScreen(screenHero);
    });

    // ─── START BUTTON ──────────────────────────────────────────────────────
    $("btnStart").addEventListener("click", function () {
      showScreen(screenConvo);
      currentStepIndex = 0;
      renderStep(0);
    });

    // ─── CONTINUE / BACK BUTTONS ───────────────────────────────────────────
    btnContinue.addEventListener("click", goNext);
    btnBack.addEventListener("click", goBack);

    // ─── TRUST COUNTER ANIMATION ──────────────────────────────────────────
    function initTrustCounters() {
      const counters = document.querySelectorAll(".trust-counter");
      if (counters.length === 0) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const target = parseInt(el.dataset.target);
              const suffix = el.dataset.suffix || "";
              const duration = 1500;
              const startTime = performance.now();

              function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                const current = Math.round(target * eased);
                el.textContent = current.toLocaleString() + suffix;
                if (progress < 1) {
                  requestAnimationFrame(update);
                } else {
                  el.textContent = target.toLocaleString() + suffix;
                }
              }
              requestAnimationFrame(update);
              observer.unobserve(el);
            }
          });
        },
        { threshold: 0.5 },
      );

      counters.forEach((c) => observer.observe(c));
    }

    // ─── KEYBOARD SUPPORT ──────────────────────────────────────────────────
    document.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && !screenConvo.classList.contains("hidden")) {
        const active = document.activeElement;
        if (
          active &&
          (active.tagName === "TEXTAREA" || active.tagName === "INPUT")
        ) {
          // Don't submit on enter in textarea or multi-line inputs
          if (active.id === "achievementInput") return;
        }
        e.preventDefault();
        goNext();
      }
      if (e.key === "Escape" && !btnBack.classList.contains("hidden")) {
        goBack();
      }
    });
    initTrustCounters(); // Initialize scroll-triggered trust counter animation
  })();
</script>
