                              fTarget +
                              ", I'd accept right away.",
                          "Another company has put forward a competitive offer. I'd much rather join " +
                              answers.company +
                              " though — if we can settle at " +
                              fTarget +
                              ", I'm in.",
                      ]
                    : [
                          answers.company +
                              " is where I want to be, and I'm confident this is the right place for me to do my best work.",
                          "I've been intentional about where I want to take my career next, and " +
                              answers.company +
                              " is the clear frontrunner.",
                          "I'm genuinely excited about the direction of " +
                              answers.company +
                              " and the impact I can have in this role.",
                      ];
            const competingLine = pick(competeVariants);
            if (answers.hrReplyEmail && answers.hrReplyEmail.length > 10) {
                const hrOpenings = [
                    "Hi there,\n\nThank you for getting back to me regarding the " +
                        answers.role +
                        " position. I really appreciate the detailed response.",
                    "Hello,\n\nThanks for your thoughtful response about the " +
                        answers.role +
                        " opportunity. I value the transparency.",
                    "Hi,\n\nI appreciate you taking the time to share more details about the " +
                        answers.role +
                        " role.",
                ];
                return (
                    pick(hrOpenings) +
                    "\n\n" +
                    t.value +
                    " " +
                    t.ask +
                    " " +
                    competingLine +
                    "\n\nI'd love to continue the conversation and find a path forward that works for both of us. Happy to discuss further on a brief call this week.\n\n" +
                    pick(closings)
                );
            }
            return (
                "Hi [Hiring Manager Name],\n\n" +
                t.opening +
                "\n\n" +
                t.value +
                " " +
                t.ask +
                " " +
                competingLine +
                "\n\n" +
                t.close +
                "\n\n" +
                pick(closings)
            );
        }

        // ─── EMAIL GENERATION ─────────────────────────────────────────────
        async function generateEmail() {
            if (isGenerating) return;
            isGenerating = true;
            showScreen(screenLoading);
            // Hide any previous error
            const loadingError = $("loadingError");
            if (loadingError) loadingError.classList.add("hidden");
            await new Promise((resolve) => setTimeout(resolve, 1200));
            try {
                const payload = {
                    role: answers.role,
                    company: answers.company,
                    location: answers.locationLabel || "Remote",
                    currentOffer: answers.currentOffer,
                    targetSalary: answers.targetSalary,
                    competingOffer: answers.competingOffer,
                    tone: answers.tone,
                    achievement: answers.achievement,
                    achievementDetail: "",
                    hrReplyEmail: answers.hrReplyEmail || "",
                    lowRange: String(answers.lowRange),
                    highRange: String(answers.highRange),
                    industry: answers.industry || "",
                    companySize: answers.companySize || "",
                };
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 30000);
                const response = await fetch("/api/generate", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                    signal: controller.signal,
                });
                clearTimeout(timeoutId);
                if (response.ok) {
                    const data = await response.json();
                    displayResult(data.text, data.isFallback || false);
                    return;
                }
                // API returned an error status — show banner and STOP
                // User can click "Dismiss" to get the template fallback
                let errorMsg =
                    "The AI service returned an error. Using template fallback.";
                try {
                    const errData = await response.json();
                    if (errData.error) errorMsg = errData.error;
                } catch {}
                showLoadingError(errorMsg);
                return; // Stay on loading screen — user must dismiss to see fallback
            } catch (err) {
                // fetch itself failed (network, timeout, abort)
                isGenerating = false;
                const errBanner = $("loadingError");
                const errMsgEl = $("loadingErrorMsg");
                if (errMsgEl) {
                    errMsgEl.textContent =
                        err && err.name === "AbortError"
                            ? "Request timed out after 30 seconds. Check your network and try again."
                            : "Network error — could not reach the AI service. Using template as fallback.";
                }
                if (errBanner) errBanner.classList.remove("hidden");
                return; // Stay on loading screen — user must dismiss to see fallback
            }
        }

        function showLoadingError(message) {
            const errorMsg = $("loadingErrorMsg");
            if (errorMsg) errorMsg.textContent = message;
            const loadingError = $("loadingError");
            if (loadingError) loadingError.classList.remove("hidden");
            // Allow user to dismiss the error and see the template result
        }

        // ─── CONFETTI ──────────────────────────────────────────────────────────
        function fireConfetti() {
            const colors = [
                "#0070f3",
                "#7928ca",
                "#ff0080",
                "#50e3c2",
                "#f5a623",
                "#ff4d4d",
                "#f9cb28",
            ];
            for (let i = 0; i < 60; i++) {
                const piece = document.createElement("div");
                piece.className = "confetti-piece";
                const color = colors[Math.floor(Math.random() * colors.length)];
                const size = 6 + Math.random() * 8;
                const isCircle = Math.random() > 0.5;
                piece.style.cssText = `left:${Math.random() * 100}vw;width:${size}px;height:${isCircle ? size : size * 2.5}px;background:${color};border-radius:${isCircle ? "50%" : "2px"};--fall-duration:${2 + Math.random() * 2}s;--fall-delay:${Math.random() * 0.8}s;opacity:${0.7 + Math.random() * 0.3};transform:rotate(${Math.random() * 360}deg);`;
                document.body.appendChild(piece);
                piece.addEventListener("animationend", () => piece.remove());
            }
        }

        // ─── TYPEWRITER ────────────────────────────────────────────────────────
        let typewriterTimer = null;
        function typewriterEffect(element, text, speed = 15, onComplete) {
            if (typewriterTimer) {
                clearTimeout(typewriterTimer);
                typewriterTimer = null;
            }
            element.value = "";
            element.classList.add("typewriter");
            let i = 0;
            function type() {
                if (i < text.length) {
                    element.value += text.charAt(i);
                    i++;
                    typewriterTimer = setTimeout(type, speed);
                } else {
                    element.classList.remove("typewriter");
                    typewriterTimer = null;
                    if (onComplete) onComplete();
                }
            }
            type();
        }

        // ─── DISPLAY RESULT ───────────────────────────────────────────────────
        function displayResult(text, isFallback) {
            lastGeneratedEmail = text;
            isGenerating = false;
            fireConfetti();
            updateDifficultyUI();
            typewriterEffect(resultText, text, 15);
            badgeSource.textContent = isFallback
                ? "Template Draft"
                : "AI Generated";
            badgeTone.textContent =
                TONES.find((t) => t.id === answers.tone)?.name || answers.tone;
            resultCaptionNote.textContent = `${answers.role} at ${answers.company} • ${answers.industryLabel || ""} • ${answers.companySizeLabel || ""} • ${answers.locationLabel || "Remote"}`;
            const wwRole = document.getElementById("wwRole");
            const wwCompany = document.getElementById("wwCompany");
            if (wwRole) wwRole.textContent = answers.role || "—";
            if (wwCompany) wwCompany.textContent = answers.company || "—";
            showScreen(screenResult);
        }

        // ─── NAVIGATION ───────────────────────────────────────────────────────
        function goNext() {
            if (!validateStep(currentStepIndex)) return;
            if (currentStepIndex === steps.length - 1) {
                generateEmail();
                return;
            }
            currentStepIndex++;
            renderStep(currentStepIndex);
        }
        function goBack() {
            if (currentStepIndex > 0) {
                currentStepIndex--;
                renderStep(currentStepIndex);
            }
        }

        btnCopy.addEventListener("click", async function () {
            try {
                await navigator.clipboard.writeText(resultText.value);
                copyText.textContent = "Copied!";
                setTimeout(() => {
                    copyText.textContent = "Copy";
                }, 2000);
            } catch {
                resultText.select();
                document.execCommand("copy");
                copyText.textContent = "Copied!";
                setTimeout(() => {
                    copyText.textContent = "Copy";
                }, 2000);
            }
        });

        btnRegen.addEventListener("click", generateEmail);

        // ─── POLISH ────────────────────────────────────────────────────────────
        function showPolishMenu() {
            const dropdown = $("polishDropdown");
            const isHidden = dropdown.classList.contains("hidden");
            if (isHidden) {
                dropdown.classList.remove("hidden");
                dropdown.classList.remove("closing");
            } else {
                dropdown.classList.add("closing");
                setTimeout(() => dropdown.classList.add("hidden"), 150);
            }
        }
        function hidePolishMenu() {
            const dropdown = $("polishDropdown");
            if (!dropdown.classList.contains("hidden")) {
                dropdown.classList.add("closing");
                setTimeout(() => dropdown.classList.add("hidden"), 150);
            }
        }

        async function polishEmail(mode) {
            const currentEmail = resultText.value.trim();
            if (!currentEmail) return;
            const polishBtn = $("btnPolish");
            const originalHtml = polishBtn.innerHTML;
            isGenerating = true;
            polishBtn.disabled = true;
            polishBtn.innerHTML =
                '<span class="spinner"></span><span>Polishing...</span>';
            try {
                const response = await fetch("/api/polish", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        email: currentEmail,
                        mode: mode,
                        context: `Role: ${answers.role}, Company: ${answers.company}, Target: $${parseInt(answers.targetSalary).toLocaleString()}, Tone: ${answers.tone}`,
                    }),
                });
                if (response.ok) {
                    const data = await response.json();
                    lastGeneratedEmail = data.text;
                    isGenerating = false;
                    typewriterEffect(resultText, data.text, 12);
                    return;
                }
                throw new Error("Polish failed");
            } catch (err) {
                try {
                    const response = await fetch("/api/polish", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            email: currentEmail,
                            mode: "fix-grammar",
                            context: `Role: ${answers.role}`,
                        }),
                    });
                    if (response.ok) {
                        const data = await response.json();
                        lastGeneratedEmail = data.text;
                        isGenerating = false;
                        typewriterEffect(resultText, data.text, 12);
                        return;
                    }
                } catch {
                    /* retry failed, keep original email */
                }
                isGenerating = false;
            } finally {
                polishBtn.disabled = false;
                polishBtn.innerHTML = originalHtml;
                hidePolishMenu();
            }
        }

        document.addEventListener("click", function (e) {
            const polishBtn = $("btnPolish");
            const dropdown = $("polishDropdown");
            if (polishBtn && dropdown) {
                if (polishBtn.contains(e.target)) {
                    e.stopPropagation();
                    showPolishMenu();
                } else if (!dropdown.contains(e.target)) {
                    hidePolishMenu();
                }
            }
            if (e.target.closest(".polish-option")) {
                const mode = e.target.closest(".polish-option").dataset.mode;
                if (mode) polishEmail(mode);
            }
        });

        // ─── INIT ──────────────────────────────────────────────────────────────
        btnContinue.addEventListener("click", goNext);
        btnBack.addEventListener("click", goBack);
        const btnDismiss = $("btnDismissLoadingError");
        if (btnDismiss) {
            btnDismiss.addEventListener("click", function () {
                // User dismissed the error — continue with the template result
                const fallbackEmail = generateFallbackEmail();
                displayResult(fallbackEmail, true);
            });
        }

        // Start with first step
        renderStep(0);

        document.addEventListener("keydown", function (e) {
            if (
                e.key === "Enter" &&
                !screenConvo.classList.contains("hidden")
            ) {
                const active = document.activeElement;
                if (
                    active &&
                    (active.tagName === "TEXTAREA" ||
                        active.tagName === "INPUT")
                ) {
                    if (
                        active.id === "achievementInput" ||
                        active.id === "hrReplyInput"
                    )
                        return;
                }
                e.preventDefault();
                goNext();
            }
            if (e.key === "Escape" && !btnBack.classList.contains("hidden")) {
                goBack();
            }
        });
    })();
</script>
