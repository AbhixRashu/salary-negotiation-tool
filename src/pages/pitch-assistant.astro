        function calculateDifficulty() {
            const currentOffer = parseFloat(answers.currentOffer) || 0;
            const targetSalary = parseFloat(answers.targetSalary) || 0;
            const hasCompeting = answers.competingOffer === "yes";
            const expId = answers.experience || "mid";
            const indId = answers.industry || "";
            const csId = answers.companySize || "";
            let gapPct = 0;
            if (currentOffer > 0 && targetSalary > 0)
                gapPct = ((targetSalary - currentOffer) / currentOffer) * 100;
            let score = 50;
            if (gapPct <= 0) score -= 15;
            else if (gapPct <= 5) score -= 10;
            else if (gapPct <= 10) score -= 5;
            else if (gapPct <= 15) score += 5;
            else if (gapPct <= 25) score += 15;
            else if (gapPct <= 40) score += 25;
            else score += 35;
            if (hasCompeting) score -= 20;
            if (expId === "entry") score += 15;
            else if (expId === "senior") score -= 10;
            else if (expId === "lead") score -= 20;
            const hardIndustries = ["nonprofit", "education", "manufacturing"];
            const easyIndustries = ["tech", "finance", "consulting"];
            if (hardIndustries.includes(indId)) score += 10;
            else if (easyIndustries.includes(indId)) score -= 8;
            if (csId === "startup") score += 12;
            else if (csId === "small") score += 5;
            else if (csId === "large" || csId === "mega") score -= 8;
            score = Math.max(0, Math.min(100, score));
            let level, leverageLabel;
            if (score <= 25) {
                level = "easy";
                leverageLabel = "Strong";
            } else if (score <= 50) {
                level = "moderate";
                leverageLabel = "Balanced";
            } else if (score <= 75) {
                level = "hard";
                leverageLabel = "Weak";
            } else {
                level = "veryHard";
                leverageLabel = "Minimal";
            }
            return {
                score,
                gapPct: Math.round(gapPct),
                level,
                leverageLabel,
                details: DIFFICULTY_LEVELS[level],
            };
        }

        function updateDifficultyUI() {
            const diff = calculateDifficulty();
            const updateEl = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.textContent = val;
            };
            const badge = document.getElementById("badgeDifficulty");
            if (badge) {
                badge.textContent = diff.details.label;
                badge.className = `inline-block px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold uppercase tracking-wider ${diff.details.badgeClass}`;
                badge.classList.remove("hidden");
            }
            const dot = document.getElementById("diffDot");
            if (dot)
                dot.className = `w-1.5 h-1.5 rounded-full ${diff.details.color}`;
            updateEl("diffLabel", diff.details.label);
            updateEl(
                "diffGap",
                diff.gapPct > 0 ? `+${diff.gapPct}%` : `${diff.gapPct}%`,
            );
            updateEl("diffLeverage", diff.leverageLabel);
            document
                .getElementById("difficultyDetail")
