        function updateProgress() {
            const total = steps.length;
            const pct = Math.round(((currentStepIndex + 1) / total) * 100);
            progressStep.textContent = `Step ${currentStepIndex + 1} of ${total}`;
            progressPct.textContent = `${pct}%`;
            progressFill.style.width = `${pct}%`;
            const color = PROGRESS_COLORS[currentStepIndex] || "#0070f3";
            progressFill.style.background = `linear-gradient(90deg, ${color}, ${PROGRESS_COLORS[Math.min(currentStepIndex + 1, PROGRESS_COLORS.length - 1)]})`;

            const dotsContainer = document.getElementById("stepDots");
            if (dotsContainer) {
                dotsContainer.innerHTML = steps
                    .map(
                        (_, i) =>
                            `<span class="step-dot inline-block w-1.5 h-1.5 rounded-full ${i <= currentStepIndex ? "opacity-100" : "opacity-20"}" style="background:${i <= currentStepIndex ? PROGRESS_COLORS[i] || "#0070f3" : "var(--mute)"}"></span>`,
                    )
                    .join("");
            }

            const stepIcon = document.getElementById("stepIcon");
            if (stepIcon) {
                const icon = STEP_ICONS[steps[currentStepIndex]?.id];
                if (icon) {
                    stepIcon.textContent = icon;
                    stepIcon.classList.remove("hidden");
                } else {
                    stepIcon.classList.add("hidden");
                }
            }
        }

        function showError(msg) {
            stepError.textContent = msg;
            stepError.classList.remove("hidden");
        }
        function hideError() {
            stepError.classList.add("hidden");
        }

        function renderStep(index) {
            const step = steps[index];
            if (!step) return;
            hideError();
            stepQuestion.textContent = step.question;
            stepHint.textContent = step.hint;
            btnBack.classList.toggle("hidden", index === 0);
            reassureLine.classList.toggle("hidden", index < 5);
            btnContinue.textContent =
                index === steps.length - 1 ? "Generate Pitch →" : "Continue";
            updateProgress();

            switch (step.type) {
                case "role-search":
                    renderRoleSearch();
                    break;
                case "select-location":
                    renderLocationSelect();
                    break;
                case "experience-select":
                    renderExperienceSelect();
                    break;
                case "industry-select":
                    renderIndustrySelect();
                    break;
                case "company-size-select":
                    renderCompanySizeSelect();
                    break;
                case "salary-slider":
                    renderSalarySlider();
                    break;
                case "text":
                    renderTextInput(step.placeholder || "");
                    break;
                case "numbers-offers":
                    renderNumbersOffers();
                    break;
                case "toggle-competing":
                    renderToggleCompeting();
                    break;
                case "textarea":
                    renderTextarea(step.placeholder || "");
                    break;
                case "hr-reply-textarea":
                    renderHrReplyTextarea();
                    break;
                case "tone-select":
                    renderToneSelect();
                    break;
                default:
                    stepInputSlot.innerHTML = "";
                    break;
