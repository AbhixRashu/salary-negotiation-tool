---
import Layout from "../layouts/Layout.astro";
import { ROLES } from "../data/salaries";
---

<Layout
    title="Salary Pitch Assistant — Negotiation Email Generator"
    description="Answer a few quick questions to receive a confident, polite, and persuasive salary counter-offer draft in under two minutes."
>
    <div class="max-w-2xl mx-auto w-full py-4 sm:py-8">
        <!-- SCREEN 1: Conversational Flow -->
        <div id="screenConvo">
            <div class="mb-6">
                <div
                    class="flex justify-between items-center text-xs font-mono text-mute mb-2"
                >
                    <span id="progressStep">Step 1 of 12</span>
                    <span id="progressPct">0%</span>
                </div>
                <div
                    class="h-2 bg-hairline rounded-full overflow-hidden shadow-inner"
                >
                    <div
                        id="progressFill"
                        class="h-full rounded-full transition-all duration-500 ease-out"
                        style="width:0%"
                    >
                    </div>
                </div>
                <div class="flex justify-between mt-1.5 px-0.5" id="stepDots">
                </div>
            </div>
            <div
                class="border border-hairline bg-canvas p-6 sm:p-8 rounded-lg shadow-sm transition-all duration-300 hover:shadow-elevated"
                id="stepCard"
            >
                <div class="flex items-center gap-3 mb-1">
                    <span id="stepIcon" class="text-lg hidden"></span>
                    <h2
                        id="stepQuestion"
                        class="text-xl sm:text-2xl font-semibold text-ink tracking-tight leading-snug"
                    >
                    </h2>
                </div>
                <p id="stepHint" class="text-xs sm:text-sm text-mute mb-6"></p>
                <div id="stepInputSlot" class="mb-6"></div>
                <div
                    id="stepError"
                    class="hidden text-xs text-red-600 bg-red-50 dark:bg-red-950/20 dark:text-red-400 p-3 rounded-md mb-4 font-mono"
                >
                </div>
                <div
                    class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4 border-t border-hairline"
                >
                    <span
                        id="reassureLine"
                        class="hidden text-xs text-mute max-w-xs leading-relaxed italic"
                    >
                        Negotiating your offer is normal and expected —
                        employers rarely rescind over a polite counter.
                    </span>
                    <div class="flex items-center gap-2 ml-auto">
                        <button
                            id="btnBack"
                            class="hidden px-5 py-2.5 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft text-body hover:text-ink text-sm transition-colors cursor-pointer ripple-btn btn-press"
                            >← Back</button
                        >
                        <button
                            id="btnContinue"
                            class="px-6 py-2.5 bg-ink text-canvas hover:bg-ink/90 font-medium rounded-full text-sm transition-all cursor-pointer ripple-btn btn-press"
                            >Continue</button
                        >
                    </div>
                </div>
            </div>
        </div>

        <!-- SCREEN 2: Generating -->
        <div id="screenLoading" class="hidden text-center py-16 result-enter">
            <div class="relative w-16 h-16 mx-auto mb-6">
                <div
                    class="absolute inset-0 border-3 border-hairline rounded-full"
                >
                </div>
                <div
                    class="absolute inset-0 border-3 border-transparent border-t-accent-blue rounded-full animate-spin"
                >
                </div>
                <div
                    class="absolute inset-2 border-3 border-transparent border-t-[#7928ca] rounded-full animate-spin"
                    style="animation-duration:0.8s;animation-direction:reverse"
                >
                </div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <span class="text-xl animate-pulse">⚡</span>
                </div>
            </div>
            <h3 class="text-lg font-semibold text-ink mb-1">
                Crafting your pitch…
            </h3>
            <p class="text-sm text-mute">
                Weaving market data with your achievements for maximum impact.
            </p>
            <div class="mt-6 flex justify-center gap-2">
                <span
                    class="w-2.5 h-2.5 rounded-full bg-accent-blue animate-bounce"
                    style="animation-delay:0s"></span>
                <span
                    class="w-2.5 h-2.5 rounded-full"
                    style="background:#7928ca;animation-delay:0.15s;animation-name:bounce;animation-duration:1s;animation-iteration-count:infinite"
                ></span>
                <span
                    class="w-2.5 h-2.5 rounded-full"
                    style="background:#ff0080;animation-delay:0.3s;animation-name:bounce;animation-duration:1s;animation-iteration-count:infinite"
                ></span>
            </div>

            <div class="shimmer-line w-3/4 mx-auto mb-2"></div>
            <div class="shimmer-line w-1/2 mx-auto"></div>
            <!-- Error banner shown when API fails -->
            <div
                id="loadingError"
                class="hidden mt-6 mx-auto max-w-sm p-4 border border-red-200 dark:border-red-900 rounded-lg bg-red-50 dark:bg-red-950/20 text-left"
            >
                <div class="flex items-start gap-3">
                    <span class="text-lg flex-shrink-0">⚠️</span>
                    <div>
                        <p
                            class="text-sm font-semibold text-red-700 dark:text-red-400"
                        >
                            AI generation failed
                        </p>
                        <p
                            id="loadingErrorMsg"
                            class="text-xs text-red-600 dark:text-red-400 mt-1 leading-relaxed"
                        >
                            The AI service didn't respond in time. We've used a
                            template as a fallback — you can edit and send it
                            directly, or try again.
                        </p>
                    </div>
                </div>
                <button
                    id="btnDismissLoadingError"
                    class="mt-3 w-full px-3 py-1.5 text-xs font-medium text-red-700 dark:text-red-400 border border-red-200 dark:border-red-900 rounded-md hover:bg-red-100 dark:hover:bg-red-950/40 transition-colors cursor-pointer"
                    >Dismiss &amp; Show Result</button
                >
            </div>
        </div>

        <!-- SCREEN 3: Result -->
        <div id="screenResult" class="hidden result-enter">
            <div
                class="border border-hairline bg-canvas rounded-lg shadow-sm overflow-hidden card-glow"
                style="position:relative;z-index:1"
            >
                <div
                    class="p-6 border-b border-hairline flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-canvas"
        >
            <div>
                <h2 class="text-lg font-semibold text-ink">
                    Your Custom Counter-Offer Email
                </h2>
                <div class="flex flex-wrap gap-2 mt-1.5 items-center">
                    <span
                        id="badgeSource"
                        class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold uppercase tracking-wider bg-canvas border border-hairline text-body"
                    ></span>
                    <span
                        id="badgeTone"
                        class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold uppercase tracking-wider bg-accent-blue/15 text-accent-blue border border-accent-blue/10"
                    ></span>
                    <span
                        id="badgeDifficulty"
                        class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold uppercase tracking-wider hidden"
                    ></span>
                </div>
            </div>
            <div
                class="hidden sm:flex items-center gap-3 px-3 py-1.5 rounded-md border border-hairline bg-canvas/50"
                id="difficultyDetail"
            >
                <div
                    class="flex items-center gap-1.5 text-xs font-mono text-mute"
                >
                    <span
                        class="w-1.5 h-1.5 rounded-full bg-emerald-500"
                        id="diffDot"></span>
                    <span id="diffLabel">Easy</span>
                </div>
                <div class="w-px h-4 bg-hairline"></div>
                <div class="text-[10px] font-mono text-mute">
                    Gap: <span id="diffGap">0%</span>
                </div>
                <div class="w-px h-4 bg-hairline"></div>
                <div class="text-[10px] font-mono text-mute">
                    Leverage: <span id="diffLeverage">Neutral</span>
                </div>
            </div>
            <div class="flex gap-2 w-full sm:w-auto">
                <button
                    id="btnCopy"
                    class="flex-1 sm:flex-none px-4 py-2 bg-accent-blue text-canvas hover:bg-accent-blue-deep font-semibold rounded-full text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer ripple-btn btn-press"
                >
                    <svg
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        ><rect x="9" y="9" width="13" height="13" rx="2" ry="2"
                        ></rect><path
                            d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                        ></path></svg
                    >
                    <span id="copyText">Copy</span>
                </button>
                <button
                    id="btnRegen"
                    class="flex-1 sm:flex-none px-4 py-2 bg-canvas hover:bg-canvas-soft-2 text-ink border border-hairline font-semibold rounded-full text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer ripple-btn btn-press"
                >
                    <svg
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        ><polyline points="23 4 23 10 17 10"></polyline><path
                            d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg
                    >
                    Regenerate
                </button>
                <div class="relative" id="polishContainer">
                    <button
                        id="btnPolish"
                        class="flex-1 sm:flex-none px-4 py-2 bg-canvas hover:bg-canvas-soft-2 text-ink border border-hairline font-semibold rounded-full text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer ripple-btn btn-press"
                    >
                        <svg
                            width="12"
                            height="12"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path d="M12 3v12"></path><path d="M8 16l4 4 4-4"
                            ></path><circle cx="12" cy="12" r="10"
                            ></circle></svg
                        >
                        <span>Polish</span>
                        <svg
                            width="10"
                            height="10"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg
                        >
                    </button>
                    <div
                        id="polishDropdown"
                        class="polish-dropdown hidden"
                        role="menu"
                        aria-label="Polish options"
                    >
                        <button
                            class="polish-option"
                            data-mode="more-assertive"
                            role="menuitem"
                        >
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                ><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"
                                ></path></svg
                            >
                            More Assertive
                        </button>
                        <button
                            class="polish-option"
                            data-mode="warmer-tone"
                            role="menuitem"
                        >
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                ><path
                                    d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                                ></path></svg
                            >
                            Warmer Tone
                        </button>
                        <button
                            class="polish-option"
                            data-mode="shorten"
                            role="menuitem"
                        >
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                ><path d="M19 13H5"></path><path d="M19 7H5"
                                ></path><path d="M19 19H5"></path></svg
                            >
                            Shorten (150 words)
                        </button>
                        <button
                            class="polish-option"
                            data-mode="expand-details"
                            role="menuitem"
                        >
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                ><path d="M5 12h14"></path><path d="M12 5v14"
                                ></path></svg
                            >
                            Lengthen with Details
                        </button>
                        <div class="polish-divider"></div>
                        <button
                            class="polish-option"
                            data-mode="add-market-data"
                            role="menuitem"
                        >
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                ><path
                                    d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
                                ></path><polyline
                                    points="3.27 6.96 12 12.01 20.73 6.96"
                                ></polyline><line
                                    x1="12"
                                    y1="22.08"
                                    x2="12"
                                    y2="12"></line></svg
                            >
                            Add Market Data
                        </button>
                        <button
                            class="polish-option"
                            data-mode="fix-grammar"
                            role="menuitem"
                        >
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                ><path
                                    d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"
                                ></path><path d="M14 2v4a2 2 0 0 0 2 2h4"
                                ></path><path d="M10 7H8"></path><path
                                    d="M10 11H8"></path><path d="M10 15H8"
                                ></path></svg
                            >
                            Fix Grammar & Flow
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="p-6">
            <textarea
                id="resultText"
                class="w-full h-80 p-4 border border-hairline rounded-md bg-canvas-soft font-sans text-sm text-ink leading-relaxed focus:border-accent-blue focus:ring-1 focus:ring-accent-blue resize-y outline-none"
                spellcheck="false"></textarea>
            <!-- Mobile difficulty detail -->
            <div
                class="mt-3 sm:hidden flex items-center justify-center gap-4 px-3 py-2 rounded-md border border-hairline bg-canvas-soft/50"
                id="difficultyDetailMobile"
            >
                <div
                    class="flex items-center gap-1.5 text-[10px] font-mono text-mute"
                >
                    <span
                        class="w-1.5 h-1.5 rounded-full bg-emerald-500"
                        id="diffDotMobile"></span>
                    <span id="diffLabelMobile">Easy</span>
                </div>
                <div class="w-px h-3 bg-hairline"></div>
                <div class="text-[10px] font-mono text-mute">
                    Gap: <span id="diffGapMobile">0%</span>
                </div>
                <div class="w-px h-3 bg-hairline"></div>
                <div class="text-[10px] font-mono text-mute">
                    Leverage: <span id="diffLeverageMobile">Neutral</span>
                </div>
            </div>
            <!-- Why This Works -->
            <div
                class="mt-4 p-3 border border-accent-blue/20 rounded-lg bg-accent-blue/5 text-xs text-body leading-relaxed"
            >
                <span
                    class="font-semibold text-accent-blue font-mono uppercase tracking-wider text-[10px]"
                    >✨ Why this works:</span
                >
                <span class="block sm:inline mt-1 sm:mt-0 sm:ml-1"
                    >This email is built from <strong class="text-ink"
                        >your specific inputs</strong
                    > — your role (<strong id="wwRole" class="text-ink"
                        >—</strong
                    >), your achievement, and your target company (<strong
                        id="wwCompany"
                        class="text-ink">—</strong
                    >). It's not a generic template — it weaves your actual
                    context into every paragraph, making it feel personal and
                    grounded in real results.</span
                >
            </div>
            <div
                class="mt-4 flex flex-col sm:flex-row justify-between items-center gap-3"
            >
                <span id="resultCaptionNote" class="text-xs font-mono text-mute"
                ></span>
                <a
                    href="/"
                    class="text-xs text-mute hover:text-ink font-mono underline transition-colors cursor-pointer"
                    >← Back to home</a
                >
            </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script define:vars={{ ROLES_DATA: ROLES }} is:inline>
    (function () {
        "use strict";

        // ─── DATA ──────────────────────────────────────────────────────────────

        const METRO_DATA = [
            { id: "nyc", name: "NYC Metro Area", multiplier: 1.2 },
            { id: "sf", name: "SF Bay Area", multiplier: 1.25 },
            { id: "la", name: "Los Angeles Area", multiplier: 1.12 },
            { id: "chicago", name: "Chicago Area", multiplier: 1.05 },
            { id: "austin", name: "Austin Area", multiplier: 1.08 },
            { id: "seattle", name: "Seattle Area", multiplier: 1.15 },
            { id: "boston", name: "Boston Area", multiplier: 1.12 },
            { id: "denver", name: "Denver Area", multiplier: 1.04 },
            { id: "atlanta", name: "Atlanta Area", multiplier: 1.0 },
            { id: "dallas", name: "Dallas-Fort Worth Area", multiplier: 1.03 },
            { id: "miami", name: "Miami Area", multiplier: 0.98 },
            {
                id: "national",
                name: "Remote / National Average",
                multiplier: 1.0,
            },
        ];

        const EXPERIENCE_DATA = [
            { id: "entry", name: "Entry-level (0-2 yrs)", multiplier: 0.75 },
            { id: "mid", name: "Mid-level (2-5 yrs)", multiplier: 1.0 },
            { id: "senior", name: "Senior (5-8 yrs)", multiplier: 1.3 },
            { id: "lead", name: "Lead / Manager (8+ yrs)", multiplier: 1.6 },
        ];

        const INDUSTRY_DATA = [
            { id: "tech", name: "Technology / SaaS", icon: "💻" },
            { id: "finance", name: "Finance & Banking", icon: "🏦" },
            { id: "healthcare", name: "Healthcare & Pharma", icon: "🏥" },
            {
                id: "consulting",
                name: "Consulting & Professional Services",
                icon: "📊",
            },
            {
                id: "manufacturing",
                name: "Manufacturing & Industrial",
                icon: "🏭",
            },
            { id: "retail", name: "Retail & E-commerce", icon: "🛒" },
            { id: "education", name: "Education & Research", icon: "🎓" },
            { id: "media", name: "Media & Entertainment", icon: "🎬" },
            {
                id: "realestate",
                name: "Real Estate & Construction",
                icon: "🏗️",
            },
            { id: "nonprofit", name: "Nonprofit & Government", icon: "🏛️" },
            { id: "energy", name: "Energy & Utilities", icon: "⚡" },
            { id: "other", name: "Other Industry", icon: "🔧" },
        ];

        const COMPANY_SIZE_DATA = [
            {
                id: "startup",
                name: "Startup (1-50 employees)",
                icon: "🚀",
                badge: "High Risk / High Reward",
            },
            {
                id: "small",
                name: "Small Business (51-200)",
                icon: "🏢",
                badge: "Flexible Culture",
            },
            {
                id: "mid",
                name: "Mid-Market (201-1,000)",
                icon: "🏬",
                badge: "Established Process",
            },
            {
                id: "large",
                name: "Large Enterprise (1,001-10,000)",
                icon: "🏛️",
                badge: "Standardized Bands",
            },
            {
                id: "mega",
                name: "Mega Corp (10,000+)",
                icon: "🌐",
                badge: "Rigid Bands / Stock",
            },
        ];

        const TONES = [
            {
                id: "confident-polite",
                name: "Confident & Polite",
                desc: "Direct, respectful, value-driven. Best for most situations.",
            },
            {
                id: "assertive",
                name: "Assertive",
                desc: "High agency, decisive, firm target. Use when you have strong leverage.",
            },
            {
                id: "warm-collaborative",
                name: "Warm & Collaborative",
                desc: "Relationship-forward, friendly. Best for smaller teams.",
            },
        ];

        const steps = [
            {
                id: "role",
                question: "What's the job title or role?",
                hint: "Search for common titles or type a custom one.",
                type: "role-search",
            },
            {
                id: "location",
                question: "Where is this role located?",
                hint: "Select a major metro or remote.",
                type: "select-location",
            },
            {
                id: "experience",
                question: "What's your experience level?",
                hint: "Four-stage brackets.",
                type: "experience-select",
            },
            {
                id: "industry",
                question: "Which industry is this role in?",
                hint: "Context shapes salary norms and negotiation room.",
                type: "industry-select",
            },
            {
                id: "salaryRange",
                question: "Confirm your target salary range",
                hint: "Adjust the slider below.",
                type: "salary-slider",
            },
            {
                id: "company",
                question: "What is the company name?",
                hint: "For personalizing the email.",
                type: "text",
                placeholder: "e.g. Stripe",
            },
            {
                id: "companySize",
                question: "How big is the company?",
                hint: "Size affects negotiation flexibility and compensation structure.",
                type: "company-size-select",
            },
            {
                id: "offers",
                question: "What are the salary numbers?",
                hint: "Provide your current offer and target.",
                type: "numbers-offers",
            },
            {
                id: "competing",
                question: "Do you have a competing offer?",
                hint: "Strong leverage if you have one.",
                type: "toggle-competing",
            },
            {
                id: "hrReply",
                question:
                    "Did the recruiter or HR reply? Paste their email here",
                hint: "We'll craft your response based on what they said. Leave blank for a fresh pitch.",
                type: "hr-reply-textarea",
            },
            {
                id: "achievement",
                question: "Describe your biggest career achievement",
                hint: "Minimum 30 words required. Include metrics, impact, team size, and revenue/outcome.",
                type: "textarea",
                placeholder:
                    "Describe your most impressive achievement in detail. Include: what the situation was, what action you took, the measurable impact (revenue, time saved, % growth), team size you led, technologies used, and recognition received...",
            },
            {
                id: "tone",
                question: "Choose a communication tone",
                hint: "Select your style.",
                type: "tone-select",
            },
        ];

        const answers = {
            role: "",
            isCustomRole: false,
            location: "",
            locationLabel: "",
            experience: "",
            experienceLabel: "",
            isFreshGraduate: null,
            industry: "",
            industryLabel: "",
            companySize: "",
            companySizeLabel: "",
            suggestedMedian: 0,
            adjustedMedian: 0,
            lowRange: 0,
            highRange: 0,
            company: "",
            currentOffer: "",
            targetSalary: "",

            competingOffer: "no",
            hrReplyEmail: "",
            achievement: "",
            tone: "",
        };

        let currentStepIndex = 0;
        let isGenerating = false;
        let lastGeneratedEmail = "";
        const $ = (id) => document.getElementById(id);
        const screenConvo = $("screenConvo");
        const screenLoading = $("screenLoading");
        const screenResult = $("screenResult");
        const stepQuestion = $("stepQuestion");
        const stepHint = $("stepHint");
        const stepInputSlot = $("stepInputSlot");
        const stepError = $("stepError");
        const btnBack = $("btnBack");
        const btnContinue = $("btnContinue");
        const progressStep = $("progressStep");
        const progressPct = $("progressPct");
