        function containsInappropriateContent(text) {
            const lower = text.toLowerCase();
            return INAPPROPRIATE_WORDS.some((word) => {
                const regex = new RegExp(
                    "\\b" + word.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "\\b",
                    "i",
                );
                return regex.test(lower);
            });
